module

public import Probability.BranchingRandomWalk.Selection.NSelection.Law.SelectedPopulation
public import Probability.BranchingRandomWalk.Population.Processes.StepSelection.RootIndexed

/-!
# Product law for a finite step-selected population

This specializes the selected-to-first-\(N\) matching theorem to a
population generated by an arbitrary measurable `Step.FiniteSelection`.
These are the local, time-homogeneous examples of causally selected branching
populations and allow zero, one, or arbitrarily many available children
before the finite rule is applied.


## Public declarations

For a measurable finite step-selection rule, recursive equal-rank
installation yields a measurable first-\(N\) field with the original
product step-field law:

\[
\operatorname{Measurable}(V_n),\qquad
\mu\circ V_n^{-1}=\operatorname{offspringFieldLaw}(\mu).
\]

* `ProbabilityTheory.BranchingRandomWalk.Selection.NSelection.RootIndexed.rankInstalledField_stepSelection_law`:
  for a measurable finite step-selection rule, recursive equal-rank
  installation gives a measurable first-`N` field with the original product
  step-field law, `μ.map Vₙ = offspringFieldLaw μ`.
-/

open MeasureTheory ProbabilityTheory

@[expose] public section

namespace ProbabilityTheory.BranchingRandomWalk.Selection.NSelection

open ProbabilityTheory.BranchingProcess (offspringFieldLaw offspringFieldLaw_coordinate offspringFieldLaw_independent offspringFieldLaw_mapMarks)

open ProbabilityTheory.BranchingRandomWalk.Coupling

open Combinatorics.UlamHarris Combinatorics.Branching
open _root_.Combinatorics.Selection.NSelection

/-- Equal-rank installation couples a finite step-selected population to the
concrete first-`N` population while preserving the product-field law. -/
theorem RootIndexed.rankInstalledField_stepSelection_law
    {Root α Mark Position Value : Type*}
    [MeasurableSpace (RootIndexed.TreeNode Root α)]
    [Countable (RootIndexed.TreeNode Root α)]
    [MeasurableSpace Mark] [MeasurableSpace Position]
    [AddCommMonoid Position] [MeasurableAdd₂ Position]
    [MeasurableSpace Value] [TopologicalSpace Value]
    [OpensMeasurableSpace Value] [LinearOrder Value]
    [SecondCountableTopology Value] [OrderClosedTopology Value]
    [MeasurableEq Value]
    [LinearOrder (RootIndexed.TreeNode Root α)]
    (μ : Measure (Step α Mark)) [IsProbabilityMeasure μ]
    (R : Step.FiniteSelection α Mark) (hR : Measurable R.select)
    (selectedBRWRoots nSelectedBRWRoots : Finset Root)
    (N : ℕ) (initial : Root → Position)
    (d : Mark → Position) (hd : Measurable d)
    (φ : Position → Value) (hφ : Measurable φ) :
    let selectedBRWPopulationOrderKey := fun k
        (field : RootIndexed.StepField (Root ⊕ Root) α Mark) =>
      RootIndexed.observedPositionAtGeneration initial d φ k
        (field.reindex Sum.inl)
    let nSelectedBRWPopulationOrderKey := fun k
        (_ : RootIndexed.StepField (Root ⊕ Root) α Mark)
        (field : RootIndexed.StepField Root α Mark) =>
      RootIndexed.observedPositionAtGeneration initial d φ k field
    let selectedBRWPopulation := fun k
        (field : RootIndexed.StepField (Root ⊕ Root) α Mark) =>
      RootIndexed.StepSelection.labelledPopulationOn R selectedBRWRoots k
        (field.reindex Sum.inl)
    let nSelectedBRWPopulation := fun k
        (_ : RootIndexed.StepField (Root ⊕ Root) α Mark)
        (field : RootIndexed.StepField Root α Mark) =>
      RootIndexed.selectedPopulationTotalized N nSelectedBRWRoots initial d φ k field
    ∀ n,
      (RootIndexed.stepFieldLaw (Root := Root ⊕ Root) μ).map
          (RootIndexed.rankInstalledField selectedBRWPopulationOrderKey nSelectedBRWPopulationOrderKey selectedBRWPopulation nSelectedBRWPopulation
            RootIndexed.StepField.left RootIndexed.StepField.right n) =
        RootIndexed.stepFieldLaw (Root := Root) μ := by
  dsimp only
  let selectedBRWPopulationOrderKey := fun k
      (field : RootIndexed.StepField (Root ⊕ Root) α Mark) =>
    RootIndexed.observedPositionAtGeneration initial d φ k
      (field.reindex Sum.inl)
  let selectedBRWPopulation := fun k
      (field : RootIndexed.StepField (Root ⊕ Root) α Mark) =>
    RootIndexed.StepSelection.labelledPopulationOn R selectedBRWRoots k
      (field.reindex Sum.inl)
  have hselectedBRWPopulationMeasurable (k : ℕ) : Measurable[RootIndexed.stepFiltration
      (Root := Root ⊕ Root) (α := α) (X := Mark) k] (selectedBRWPopulation k) := by
    exact (RootIndexed.StepSelection.labelledPopulationOn_adapted
      R hR selectedBRWRoots k).comp
        (RootIndexed.StepField.reindex_filtration_measurable Sum.inl k)
  have hselectedBRWPopulationFiber (k : ℕ) (s : Finset (RootIndexed.TreeNode Root α)) :
      MeasurableSet[RootIndexed.stepFiltration
        (Root := Root ⊕ Root) (α := α) (X := Mark) k]
        {field | selectedBRWPopulation k field = s} :=
    hselectedBRWPopulationMeasurable k (measurableSet_singleton s)
  have hselectedBRWPopulationRange (k : ℕ) : (Set.range (selectedBRWPopulation k)).Countable :=
    Set.to_countable _
  have hselectedBRWPopulationOrderKeyMeasurable (k : ℕ) : ∀ p q,
      Measurable[RootIndexed.stepFiltration
        (Root := Root ⊕ Root) (α := α) (X := Mark) k]
        fun field => valueKey (selectedBRWPopulationOrderKey k field) q <
          valueKey (selectedBRWPopulationOrderKey k field) p := by
    let _ : MeasurableSpace
        (RootIndexed.StepField (Root ⊕ Root) α Mark) :=
      RootIndexed.stepFiltration
        (Root := Root ⊕ Root) (α := α) (X := Mark) k
    intro p q
    apply measurable_valueKey_lt
    intro r
    exact hφ.comp ((RootIndexed.positionAtGeneration_measurable
      initial d hd k r.1 r.2).comp
        (RootIndexed.StepField.reindex_filtration_measurable Sum.inl k))
  have hselectedBRWPopulationDepth : ∀ k field p, p ∈ selectedBRWPopulation k field → p.2.length = k := by
    intro k field p hp
    exact RootIndexed.StepSelection.labelledPopulationOn_depth
      R selectedBRWRoots k (field.reindex Sum.inl) hp
  exact fun n =>
    (RootIndexed.rankInstalledField_totalizedSelectedPopulation_measurable_law
      μ N nSelectedBRWRoots initial d hd φ hφ selectedBRWPopulationOrderKey selectedBRWPopulation
      hselectedBRWPopulationDepth hselectedBRWPopulationFiber hselectedBRWPopulationRange hselectedBRWPopulationOrderKeyMeasurable n).2

end ProbabilityTheory.BranchingRandomWalk.Selection.NSelection

end
