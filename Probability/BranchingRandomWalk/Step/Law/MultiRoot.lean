module

public import Probability.BranchingRandomWalk.Step.Presentation.Basic
public import Combinatorics.BranchingWalk.Step.Ordering.Monotone
public import Probability.BranchingRandomWalk.Genealogy.RootIndexed.Law.Basic
public import Probability.BranchingRandomWalk.Step.PointMeasure.Basic
public import Probability.BranchingRandomWalk.Step.Ordering.Support

/-!
# Independent multi-root fields generated by a random step

The random variable `S` determines the step law. Independent samples from its
pushforward law are assigned at every address and root. Point measures and
ordered support are derived observations of those deterministic steps.

For a root-indexed field \(\omega\), every point-measure coordinate has the
one-step branching law, and ordered nonempty support gives a simultaneous
first-child property:

\[\begin{aligned}
\operatorname{map}(\omega\mapsto\operatorname{stepPointMeasure}(\omega(r,u)),
  \operatorname{stepFieldLaw}(S.\operatorname{indexedLaw}(P)))
  &=S.\operatorname{branchingLaw}(P),\\
\mathbb P_{\mathrm{field}}\!\left(\forall r,u,\;
  \operatorname{survive}(\omega(r,u),0)\right)&=1.
\end{aligned}\]

## Public declarations

- `ProbabilityTheory.BranchingRandomWalk.RootIndexed.step_pointMeasure_marginal`:
  the point measure observed at any root and address has the point-measure law
  of the original random step.
- `ProbabilityTheory.BranchingRandomWalk.step_multiRoot_pointMeasure_marginal`:
  the same marginal identity holds in a finite-root step field.
- `ProbabilityTheory.BranchingRandomWalk.RootIndexed.step_all_first_child`:
  if every sampled step has ordered, nonempty support, then almost surely the
  first selected child slot is present at every root and address.
- `ProbabilityTheory.BranchingRandomWalk.step_multiRoot_all_first_child`:
  the same simultaneous first-child property holds for a finite-root field.

-/

@[expose] public section

open MeasureTheory

namespace ProbabilityTheory.BranchingRandomWalk

open Combinatorics.UlamHarris Combinatorics.Branching

theorem RootIndexed.step_pointMeasure_marginal
    {Root Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (S : StepPresentation Ω ℕ ℝ)
    (r : Root) (u : 𝕍) :
    (RootIndexed.stepFieldLaw (Root := Root) (S.indexedLaw P)).map
        (fun ω : RootIndexed.StepField Root ℕ ℝ =>
          stepPointMeasure (ω r u)) =
      S.branchingLaw P := by
  rw [← S.indexedLaw_map_pointMeasure P]
  calc
    (RootIndexed.stepFieldLaw (Root := Root) (S.indexedLaw P)).map
        (fun ω : RootIndexed.StepField Root ℕ ℝ =>
          stepPointMeasure (ω r u)) =
        ((RootIndexed.stepFieldLaw (Root := Root) (S.indexedLaw P)).map
          (fun ω : RootIndexed.StepField Root ℕ ℝ => ω r u)).map
            stepPointMeasure := by
          rw [Measure.map_map]
          · rfl
          · exact stepPointMeasure_measurable
          · exact (measurable_pi_apply u).comp (measurable_pi_apply r)
    _ = (S.indexedLaw P).map stepPointMeasure := by
      rw [RootIndexed.stepFieldLaw_coordinate_marginal]

theorem step_multiRoot_pointMeasure_marginal
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (S : StepPresentation Ω ℕ ℝ)
    {m : ℕ} (i : Fin m) (u : 𝕍) :
    (finiteRootStepFieldLaw (S.indexedLaw P) m).map
        (fun ω : FiniteRootStepField m ℕ ℝ => stepPointMeasure (ω i u)) =
      S.branchingLaw P := by
  exact RootIndexed.step_pointMeasure_marginal P S i u

theorem RootIndexed.step_all_first_child
    {Root Ω : Type*} [Countable Root] [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (S : StepPresentation Ω ℕ ℝ)
    (hordered : ∀ ω, S ω ∈ orderedSteps)
    (hnonempty : ∀ ω, S ω ∈ nonemptySupport) :
    ∀ᵐ field ∂RootIndexed.stepFieldLaw (Root := Root) (S.indexedLaw P),
      ∀ r : Root, ∀ u : 𝕍, survive (field r u) 0 := by
  have horderedLaw : S.indexedLaw P orderedSteps = 1 := by
    rw [S.indexedLaw_apply P orderedSteps
      (orderedSteps_measurable (ι := ℕ))]
    have hpre : S ⁻¹' orderedSteps = Set.univ := by
      ext ω
      simp [hordered ω]
    rw [hpre]
    simp
  have hnonemptyLaw : S.indexedLaw P nonemptySupport = 1 := by
    rw [S.indexedLaw_apply P nonemptySupport nonemptySupport_measurable]
    have hpre : S ⁻¹' nonemptySupport = Set.univ := by
      ext ω
      simp [hnonempty ω]
    rw [hpre]
    simp
  filter_upwards
    [RootIndexed.stepFieldLaw_ae_all_of_measure_one
      (Root := Root) orderedSteps_measurable (S.indexedLaw P) horderedLaw,
     RootIndexed.stepFieldLaw_ae_all_of_measure_one
      (Root := Root) nonemptySupport_measurable (S.indexedLaw P) hnonemptyLaw]
      with field hord hne
  intro r u
  obtain ⟨j, hj⟩ := hne r u
  exact orderedSteps_survive_of_le (field r u) (hord r u) (Nat.zero_le j) hj

theorem step_multiRoot_all_first_child
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (S : StepPresentation Ω ℕ ℝ) (m : ℕ)
    (hordered : ∀ ω, S ω ∈ orderedSteps)
    (hnonempty : ∀ ω, S ω ∈ nonemptySupport) :
    ∀ᵐ field ∂finiteRootStepFieldLaw (S.indexedLaw P) m,
      ∀ i : Fin m, ∀ u : 𝕍, survive (field i u) 0 := by
  exact RootIndexed.step_all_first_child
    (Root := Fin m) P S hordered hnonempty

end ProbabilityTheory.BranchingRandomWalk
