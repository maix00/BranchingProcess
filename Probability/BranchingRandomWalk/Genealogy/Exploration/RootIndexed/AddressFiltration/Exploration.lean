module

public import Probability.BranchingRandomWalk.Genealogy.Exploration.RootIndexed.AddressFiltration.RootSubset
public import Mathlib.Probability.Independence.Basic

/-!
# Fresh descendants of a root-indexed exploration

## Public declarations

For a root-indexed step field with arbitrary root type `Root` and address
alphabet `α`, the public declarations in `ProbabilityTheory.BranchingRandomWalk.RootIndexed`
are:

- `descendantAddresses root` is
  \[
    \{(r,u):r=\mathrm{root}.1,\ u=\mathrm{root}.2\mathbin{++}v
      \text{ for some }v\}.
  \]
- `descendantSpace root` is the sigma-algebra generated by those coordinates;
  `descendantSpace_eq_iSup root` identifies it with the iterated supremum of
  the descendant coordinate sigma-algebras.
- `descendantStepField root` is the subtree field
  \[
    v\longmapsto \omega(\mathrm{root}.1,
      \mathrm{root}.2\mathbin{++}v),
  \]
  and `descendantStepField_measurable root` proves its measurability in
  `descendantSpace root`.
- `ExplorationDomains Root α X` records increasing inspected coordinate sets
  and sigma-algebras bounded by the coordinates they inspect.
  `ExplorationDomains.fresh_descendant_independent` gives independence from a
  fixed descendant-coordinate sigma-algebra when the inspected set is
  disjoint from it; `ExplorationDomains.fresh_subtree_independent` gives the
  corresponding independence for the subtree field.

The statements apply to arbitrary root and slot types. The finite-root,
natural-slot construction is an instance of this interface. Product-coordinate
independence is supplied by `RootIndexed.stepFieldLaw_coordinates_independent`.
-/

open MeasureTheory ProbabilityTheory

@[expose] public section

namespace ProbabilityTheory.BranchingRandomWalk

open ProbabilityTheory.BranchingProcess (offspringFieldLaw offspringFieldLaw_coordinate offspringFieldLaw_independent offspringFieldLaw_mapMarks)

open Combinatorics.UlamHarris Combinatorics.Branching MeasureTheory

namespace RootIndexed

/-- The complete set of coordinates below a fixed root-address pair. -/
def descendantAddresses {Root α : Type*} (root : Root × TreeNode α) :
    Set (Root × TreeNode α) :=
  {p | ∃ tail : TreeNode α, p = (root.1, root.2 ++ tail)}

/-- The sigma-algebra generated by all step coordinates below `root`. -/
@[instance_reducible] def descendantSpace
    {Root α X : Type*} [MeasurableSpace X]
    (root : Root × TreeNode α) : MeasurableSpace (StepField Root α X) :=
  ⨆ tail : TreeNode α,
    stepCoordinateSpace (root.1, root.2 ++ tail)

/-- The descendant-coordinate sigma-algebra is the supremum over all
coordinates in the descendant set. -/
theorem descendantSpace_eq_iSup
    {Root α X : Type*} [MeasurableSpace X]
    (root : Root × TreeNode α) :
    descendantSpace (X := X) root =
      stepSpace (X := X) (descendantAddresses root) := by
  apply le_antisymm
  · apply iSup_le
    intro tail
    exact le_iSup_of_le (root.1, root.2 ++ tail)
      (le_iSup_of_le ⟨tail, rfl⟩ le_rfl)
  · apply iSup_le
    intro p
    apply iSup_le
    rintro ⟨tail, rfl⟩
    exact le_iSup (fun v : TreeNode α =>
      stepCoordinateSpace (root.1, root.2 ++ v)) tail

/-- The descendant step field rooted at a fixed root-address pair. -/
def descendantStepField
    {Root α X : Type*} (root : Root × TreeNode α)
    (field : StepField Root α X) : TreeNode α → Step α X :=
  fun tail => field root.1 (root.2 ++ tail)

/-- A descendant step field is measurable with respect to the coordinates
from which it is assembled. -/
theorem descendantStepField_measurable
    {Root α X : Type*} [MeasurableSpace X]
    (root : Root × TreeNode α) :
    Measurable[descendantSpace (X := X) root]
      (descendantStepField root) := by
  apply (@measurable_pi_iff (StepField Root α X) (TreeNode α)
    (fun _ => Step α X) (descendantSpace (X := X) root)
    (fun _ => inferInstance) (descendantStepField root)).2
  intro tail
  have hle : stepCoordinateSpace (X := X)
      (root.1, root.2 ++ tail) ≤ descendantSpace root :=
    le_iSup (fun v : TreeNode α =>
      stepCoordinateSpace (X := X) (root.1, root.2 ++ v)) tail
  have hcoord : Measurable[stepCoordinateSpace (X := X)
      (root.1, root.2 ++ tail)]
      (fun field : StepField Root α X =>
        field root.1 (root.2 ++ tail)) :=
    Measurable.of_comap_le le_rfl
  exact hcoord.mono hle le_rfl

/-- An exploration domain is bounded by the coordinates it has inspected;
the inspected coordinate sets increase with time. -/
structure ExplorationDomains
    (Root α X : Type*) [MeasurableSpace X] where
  inspected : ℕ → Set (Root × TreeNode α)
  domain : ℕ → MeasurableSpace (StepField Root α X)
  domain_le : ∀ j, domain j ≤ stepSpace (X := X) (inspected j)
  inspected_mono : Monotone inspected

/-- A domain of an exploration is independent of the full subtree below any
root whose descendants are disjoint from the inspected coordinates. -/
theorem ExplorationDomains.fresh_descendant_independent
    {Root α X : Type*} [MeasurableSpace X]
    (μ : Measure (Step α X)) [IsProbabilityMeasure μ]
    (H : ExplorationDomains Root α X) (j : ℕ)
    (root : Root × TreeNode α)
    (hfresh : Disjoint (H.inspected j) (descendantAddresses root)) :
    Indep (H.domain j) (descendantSpace (X := X) root)
      (RootIndexed.stepFieldLaw (Root := Root) μ) := by
  rw [descendantSpace_eq_iSup]
  apply indep_of_indep_of_le_left
    (stepSpace_independent μ (H.inspected j)
      (descendantAddresses root) hfresh)
  exact H.domain_le j

/-- The random subtree field below a fresh root is independent of the
exploration domain. -/
theorem ExplorationDomains.fresh_subtree_independent
    {Root α X : Type*} [MeasurableSpace X]
    (μ : Measure (Step α X)) [IsProbabilityMeasure μ]
    (H : ExplorationDomains Root α X) (j : ℕ)
    (root : Root × TreeNode α)
    (hfresh : Disjoint (H.inspected j) (descendantAddresses root)) :
    Indep (H.domain j)
      (MeasurableSpace.comap (descendantStepField root) inferInstance)
      (RootIndexed.stepFieldLaw (Root := Root) μ) :=
  indep_of_indep_of_le_right
    (H.fresh_descendant_independent μ j root hfresh)
    (descendantStepField_measurable root).comap_le

end RootIndexed

end ProbabilityTheory.BranchingRandomWalk

end
