module

public import Probability.BranchingRandomWalk.Genealogy.RootIndexed.Field.Filtration
public import Probability.BranchingRandomWalk.Genealogy.RootIndexed.Law.Basic

/-!
# Independence of past and future coordinates

## Public declarations

In namespace `ProbabilityTheory.BranchingRandomWalk`, the public declarations
are:

- `RootIndexed.step_past_future_independent μ n` states that the past
  filtration generated by levels below `n` and the future coordinate
  sigma-algebra generated by levels at least `n` are independent under the
  root-indexed product law:
  $\operatorname{Indep}(\mathcal F_n,\sigma(\omega(r,u):|u|\ge n),\nu)$.
The root and child-slot types are arbitrary. The theorem combines the
root-indexed product-law coordinate independence with disjointness of strict
past and future addresses; Mathlib's `indep_iSup_of_disjoint` supplies the
sigma-algebra independence step.
-/

open MeasureTheory ProbabilityTheory

@[expose] public section

namespace ProbabilityTheory.BranchingRandomWalk

open ProbabilityTheory.BranchingProcess (offspringFieldLaw offspringFieldLaw_coordinate offspringFieldLaw_independent offspringFieldLaw_mapMarks)

open Combinatorics.UlamHarris Combinatorics.Branching MeasureTheory

namespace RootIndexed

/-- The past and future coordinate spaces of one root-indexed field are
independent under its product law. -/
theorem step_past_future_independent
    {Root α X : Type*} [MeasurableSpace X]
    (μ : Measure (Step α X)) [IsProbabilityMeasure μ] (n : ℕ) :
    Indep (stepFiltration (Root := Root) (α := α) (X := X) n)
      (stepFutureSpace (Root := Root) (α := α) (X := X) n)
      (RootIndexed.stepFieldLaw (Root := Root) μ) := by
  have hle : ∀ p : Root × TreeNode α,
      stepCoordinateSpace (X := X) p ≤
        (inferInstance : MeasurableSpace (StepField Root α X)) := by
    intro p
    have hm : Measurable (fun ω : StepField Root α X => ω p.1 p.2) :=
      (measurable_pi_apply p.2 : Measurable
        (fun field : TreeNode α → Step α X => field p.2)).comp
        (measurable_pi_apply p.1 : Measurable
          (fun ω : StepField Root α X => ω p.1))
    exact hm.comap_le
  have hdisj : Disjoint
      {p : Root × TreeNode α | p.2.length < n}
      {p : Root × TreeNode α | n ≤ p.2.length} := by
    apply Set.disjoint_left.mpr
    intro p hp hf
    change p.2.length < n at hp
    change n ≤ p.2.length at hf
    exact (not_lt_of_ge hf) hp
  change Indep
    (RootIndexed.stepGenerationSpace
      (Root := Root) (α := α) (X := X) n)
    (RootIndexed.stepFutureSpace (Root := Root) (α := α) (X := X) n)
    (RootIndexed.stepFieldLaw (Root := Root) μ)
  rw [stepGenerationSpace_eq_coordinate_iSup]
  exact indep_iSup_of_disjoint hle
    (stepFieldLaw_coordinates_independent (Root := Root) μ) hdisj

end RootIndexed

end ProbabilityTheory.BranchingRandomWalk

end
