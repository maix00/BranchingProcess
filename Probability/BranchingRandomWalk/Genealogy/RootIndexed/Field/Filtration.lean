module

public import Probability.BranchingRandomWalk.Genealogy.RootIndexed.Field.Basic
public import Probability.BranchingRandomWalk.Tree.Filtration

import MeasureTheory.MeasurableSpace.CountableEvaluation

/-!
# Generation filtrations on root-indexed step fields

The public declarations are:

* `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepCoordinateSpace p`
  is the comap of evaluation at root/address `p`;
  `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepGenerationSpace n`
  is generated by coordinate events at addresses `u.length < n`, and
  `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepFiltration` uses
  these spaces at time `n`.
* `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepGenerationSpace_zero`
  states `stepGenerationSpace 0 = ⊥`, and
  `ProbabilityTheory.BranchingRandomWalk.RootIndexed.step_measurable` states
  that `ω ↦ ω r u` is measurable at generation `n` when `u.length < n`.
* `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepFutureSpace n` is the
  supremum of coordinate spaces with address depth at least `n`;
  `ProbabilityTheory.BranchingRandomWalk.RootIndexed.stepGenerationSpace_eq_coordinate_iSup`
  gives the matching supremum formula for depths below `n`.
* `ProbabilityTheory.BranchingRandomWalk.RootIndexed.field_measurable` states
  measurability of the fixed-root field `ω ↦ ω r`;
  `ProbabilityTheory.BranchingRandomWalk.RootIndexed.StepField.reindex_filtration_measurable`
  states that root relabelling `ω ↦ ω (f r)` preserves the generation
  filtration.
* `ProbabilityTheory.BranchingRandomWalk.RootIndexed.selectedStep_measurable`
  states measurability of
  `ω ↦ ω (chosen ω).1 (chosen ω).2` from measurable selector fibers, a depth
  bound, and countable range. The
  `ProbabilityTheory.BranchingRandomWalk.multiRootStepGenerationSpace` and
  `ProbabilityTheory.BranchingRandomWalk.multiRootStepFiltration` definitions,
  together with
  `ProbabilityTheory.BranchingRandomWalk.multiRootStepGenerationSpace_zero`,
  `ProbabilityTheory.BranchingRandomWalk.multiRootStep_measurable`, and
  `ProbabilityTheory.BranchingRandomWalk.multiRootSelectedStep_measurable`,
  specialize this API to `Root = Fin m` and `α = ℕ`.

The primary definitions allow arbitrary root and child-slot types.  The
finite-root names are specializations retained for finite-population results.
No finiteness or countability assumption is needed to generate the domain
flow or to observe a fixed coordinate.
-/

open MeasureTheory

@[expose] public section

namespace ProbabilityTheory.BranchingRandomWalk

open Combinatorics.UlamHarris Combinatorics.Branching MeasureTheory


/-- The measurable space generated by one fixed root/address coordinate. -/
@[instance_reducible] def RootIndexed.stepCoordinateSpace
    {Root α X : Type*} [MeasurableSpace X]
    (p : Root × TreeNode α) :
    MeasurableSpace (RootIndexed.StepField Root α X) :=
  MeasurableSpace.comap (fun ω => ω p.1 p.2) inferInstance


@[instance_reducible] def RootIndexed.stepGenerationSpace
    {Root α X : Type*} [MeasurableSpace X] (n : ℕ) :
    MeasurableSpace (RootIndexed.StepField Root α X) :=
  MeasurableSpace.generateFrom
    {s | ∃ r : Root, ∃ u : TreeNode α, u.length < n ∧
      ∃ t : Set (Step α X), MeasurableSet t ∧
        s = {ω : RootIndexed.StepField Root α X | ω r u ∈ t}}

def RootIndexed.stepFiltration
    {Root α X : Type*} [MeasurableSpace X] :
    Filtration ℕ
      (inferInstance : MeasurableSpace (RootIndexed.StepField Root α X)) where
  seq := RootIndexed.stepGenerationSpace
  mono' := by
    intro n k hnk
    apply MeasurableSpace.generateFrom_mono
    rintro s ⟨r, u, hu, t, ht, rfl⟩
    exact ⟨r, u, lt_of_lt_of_le hu hnk, t, ht, rfl⟩
  le' := by
    intro n
    apply MeasurableSpace.generateFrom_le
    rintro s ⟨r, u, hu, t, ht, rfl⟩
    exact ((measurable_pi_apply u).comp (measurable_pi_apply r)) ht

theorem RootIndexed.stepGenerationSpace_zero
    {Root α X : Type*} [MeasurableSpace X] :
    RootIndexed.stepGenerationSpace (Root := Root) (α := α) (X := X) 0 = ⊥ := by
  unfold RootIndexed.stepGenerationSpace
  have hgen :
      {s : Set (RootIndexed.StepField Root α X) |
        ∃ r : Root, ∃ u : TreeNode α, u.length < 0 ∧
          ∃ t : Set (Step α X), MeasurableSet t ∧
            s = {ω : RootIndexed.StepField Root α X | ω r u ∈ t}} = ∅ := by
    ext s
    simp
  rw [hgen, MeasurableSpace.generateFrom_empty]

theorem RootIndexed.step_measurable
    {Root α X : Type*} {n : ℕ} [MeasurableSpace X]
    (r : Root) (u : TreeNode α) (hu : u.length < n) :
    Measurable[RootIndexed.stepFiltration (Root := Root) (α := α) (X := X) n]
      (fun ω : RootIndexed.StepField Root α X => ω r u) := by
  intro t ht
  exact MeasurableSpace.measurableSet_generateFrom
    ⟨r, u, hu, t, ht, rfl⟩

/-- The coordinates revealed at or after generation `n`. -/
@[instance_reducible] def RootIndexed.stepFutureSpace
    {Root α X : Type*} [MeasurableSpace X] (n : ℕ) :
    MeasurableSpace (RootIndexed.StepField Root α X) :=
  ⨆ p ∈ {p : Root × TreeNode α | n ≤ p.2.length},
    RootIndexed.stepCoordinateSpace p

theorem RootIndexed.stepGenerationSpace_eq_coordinate_iSup
    {Root α X : Type*} [MeasurableSpace X] (n : ℕ) :
    RootIndexed.stepGenerationSpace (Root := Root) (α := α) (X := X) n =
      ⨆ p ∈ {p : Root × TreeNode α | p.2.length < n},
        RootIndexed.stepCoordinateSpace (X := X) p := by
  apply le_antisymm
  · apply MeasurableSpace.generateFrom_le
    rintro s ⟨r, u, hu, t, ht, rfl⟩
    have hle : RootIndexed.stepCoordinateSpace (X := X) (r, u) ≤
        ⨆ p ∈ {p : Root × TreeNode α | p.2.length < n},
          RootIndexed.stepCoordinateSpace (X := X) p :=
      le_iSup_of_le (r, u) (le_iSup_of_le hu le_rfl)
    apply hle
    exact ⟨t, ht, rfl⟩
  · apply iSup_le
    intro p
    apply iSup_le
    intro hp
    exact (RootIndexed.step_measurable (X := X) p.1 p.2 hp).comap_le


/-- Restricting a root-indexed field to one fixed root preserves the
generation domain flow.  This needs no countability assumption on either the
root labels or the child slots: every generator in the target observes one
fixed coordinate. -/
theorem RootIndexed.field_measurable
    {Root α X : Type*} [MeasurableSpace X] (r : Root) (n : ℕ) :
    @Measurable
      (RootIndexed.StepField Root α X) (Mark α (Step α X))
      (RootIndexed.stepFiltration (Root := Root) (α := α) (X := X) n)
      (generationFiltration (α := α) (M := Step α X) n)
      (fun ω => ω r) := by
  let _ : MeasurableSpace (RootIndexed.StepField Root α X) :=
    RootIndexed.stepFiltration (Root := Root) (α := α) (X := X) n
  apply measurable_generateFrom
  intro s hs
  obtain ⟨u, hu, t, ht, rfl⟩ := hs
  exact (RootIndexed.step_measurable (X := X) r u hu) ht

/-- Reindexing roots is measurable between generation domains.  No
injectivity, finiteness, or countability assumption on either root type is
needed. -/
theorem RootIndexed.StepField.reindex_filtration_measurable
    {Root NewRoot α X : Type*} [MeasurableSpace X]
    (f : NewRoot → Root) (n : ℕ) :
    @Measurable
      (RootIndexed.StepField Root α X)
      (RootIndexed.StepField NewRoot α X)
      (RootIndexed.stepFiltration
        (Root := Root) (α := α) (X := X) n)
      (RootIndexed.stepFiltration
        (Root := NewRoot) (α := α) (X := X) n)
      (RootIndexed.StepField.reindex f) := by
  let _ : MeasurableSpace (RootIndexed.StepField Root α X) :=
    RootIndexed.stepFiltration n
  let _ : MeasurableSpace (RootIndexed.StepField NewRoot α X) :=
    RootIndexed.stepFiltration n
  change Measurable (RootIndexed.StepField.reindex f)
  apply measurable_generateFrom
  intro s hs
  obtain ⟨r, u, hu, t, ht, rfl⟩ := hs
  exact (RootIndexed.step_measurable (X := X) (f r) u hu) ht

/-- A random root/address coordinate can be read from the generation domain
flow when its choice is domain-measurable, lies below the generation, and has
countable range.  The field, root type, and offspring-slot type themselves may
all be uncountable; countability is localized to the actually selected labels
needed for the measurable union. -/
theorem RootIndexed.selectedStep_measurable
    {Root α X : Type*} {n : ℕ} [MeasurableSpace X]
    (chosen : RootIndexed.StepField Root α X → Root × TreeNode α)
    (hfiber : ∀ p, MeasurableSet[
      RootIndexed.stepFiltration (Root := Root) (α := α) (X := X) n]
        {ω | chosen ω = p})
    (hdepth : ∀ ω, (chosen ω).2.length < n)
    (hcount : (Set.range chosen).Countable) :
    Measurable[RootIndexed.stepFiltration
      (Root := Root) (α := α) (X := X) n]
      (fun ω : RootIndexed.StepField Root α X =>
        ω (chosen ω).1 (chosen ω).2) := by
  let _ : MeasurableSpace (RootIndexed.StepField Root α X) :=
    RootIndexed.stepFiltration (Root := Root) (α := α) (X := X) n
  exact Measurable.eval_of_countable_range
    (fun ω p => ω p.1 p.2) chosen
    (fun p hp => by
      have hpdepth : p.2.length < n := by
        obtain ⟨ω, hω⟩ := hp
        simpa [← hω] using hdepth ω
      exact RootIndexed.step_measurable (X := X) p.1 p.2 hpdepth)
    (fun p _ => hfiber p) hcount


/-- The finite multi-root generation domain flow is the root-indexed
filtration specialized to `Root = Fin m` and the natural Ulam--Harris slot
type. This adapter keeps the finite-population terminology while sharing the
general implementation. -/
abbrev multiRootStepGenerationSpace
    {m : ℕ} {X : Type*} [MeasurableSpace X] (n : ℕ) :
    MeasurableSpace (FiniteRootStepField m ℕ X) :=
  RootIndexed.stepGenerationSpace (Root := Fin m) (α := ℕ) (X := X) n

/-- The filtration observed by `m` initially labelled trees, as the explicit
finite-root specialization of `RootIndexed.stepFiltration`. -/
abbrev multiRootStepFiltration
    {m : ℕ} {X : Type*} [MeasurableSpace X] :
    Filtration ℕ (inferInstance : MeasurableSpace (FiniteRootStepField m ℕ X)) :=
  RootIndexed.stepFiltration (Root := Fin m) (α := ℕ) (X := X)

theorem multiRootStepGenerationSpace_zero
    {m : ℕ} {X : Type*} [MeasurableSpace X] :
    multiRootStepGenerationSpace (m := m) (X := X) 0 = ⊥ := by
  exact RootIndexed.stepGenerationSpace_zero
    (Root := Fin m) (α := ℕ) (X := X)

theorem multiRootStep_measurable
    {m n : ℕ} {X : Type*} [MeasurableSpace X]
    (i : Fin m) (u : 𝕍) (hu : u.length < n) :
    Measurable[multiRootStepFiltration (m := m) (X := X) n]
      (fun ω : FiniteRootStepField m ℕ X => ω i u) :=
  RootIndexed.step_measurable (Root := Fin m) (α := ℕ) (X := X) i u hu

/-- A randomly chosen address under a fixed finite root is a special case of
the arbitrary-root, countable-range coordinate-selection theorem. -/
theorem multiRootSelectedStep_measurable
    {m n : ℕ} {X : Type*} [MeasurableSpace X]
    (i : Fin m)
    (chosen : FiniteRootStepField m ℕ X → 𝕍)
    (hchosen : Measurable[
      multiRootStepFiltration (m := m) (X := X) n] chosen)
    (hdepth : ∀ ω, (chosen ω).length < n) :
    Measurable[multiRootStepFiltration (m := m) (X := X) n]
      (fun ω : FiniteRootStepField m ℕ X => ω i (chosen ω)) := by
  let chosenRootAddress :
      FiniteRootStepField m ℕ X → Fin m × TreeNode ℕ :=
    fun ω => (i, chosen ω)
  have hchosenRootAddress : Measurable[
      RootIndexed.stepFiltration (Root := Fin m) (α := ℕ) (X := X) n]
      chosenRootAddress := by
    exact (measurable_const.prodMk hchosen)
  have hfiber (p : Fin m × TreeNode ℕ) :
      MeasurableSet[RootIndexed.stepFiltration
        (Root := Fin m) (α := ℕ) (X := X) n]
        {ω | chosenRootAddress ω = p} :=
    hchosenRootAddress (measurableSet_singleton p)
  have hcount : (Set.range chosenRootAddress).Countable := by
    exact Set.countable_univ.mono (Set.subset_univ _)
  exact RootIndexed.selectedStep_measurable chosenRootAddress hfiber
    (fun ω => hdepth ω) hcount

end ProbabilityTheory.BranchingRandomWalk
