module

public import Combinatorics.UlamHarris.Basic
public import Mathlib.MeasureTheory.Constructions.Pi
public import Probability.Process.Filtration.GeneratedByCoordinates

import MeasureTheory.MeasurableSpace.CountableEvaluation

/-!
# The generation filtration on a pre-sampled mark field

The public declarations are:

* `ProbabilityTheory.BranchingRandomWalk.instMeasurableSpaceTreeNode` gives
  `TreeNode α` the discrete measurable space.
* `ProbabilityTheory.BranchingRandomWalk.generationSpace n` is generated by
  coordinate events `{ω | ω u ∈ t}` with `u.length < n`, and
  `ProbabilityTheory.BranchingRandomWalk.generationFiltration` has this space
  at time `n`.
* `ProbabilityTheory.BranchingRandomWalk.generationSpace_zero` states
  `generationSpace 0 = ⊥`;
  `ProbabilityTheory.BranchingRandomWalk.mark_measurable_of_depth_lt` and
  `ProbabilityTheory.BranchingRandomWalk.mark_measurable_next` state that
  `ω ↦ ω u` is measurable once `u.length < n`.
* `ProbabilityTheory.BranchingRandomWalk.frontierMarks n ω u = if u.length = n
  then ω u else default`, and
  `ProbabilityTheory.BranchingRandomWalk.frontierMarks_measurable` states its
  measurability at generation `n + 1`.
* `ProbabilityTheory.BranchingRandomWalk.selected_mark_measurable_of_countable_range`
  proves measurability of `ω ↦ ω (chosen ω)` from measurable selector fibers,
  depth below `n`, and a countable selector range;
  `ProbabilityTheory.BranchingRandomWalk.selected_mark_measurable` is its
  countable-slot specialization.
* `ProbabilityTheory.BranchingRandomWalk.causal_lineage_adapted_of_countable_range`
  proves each `path n` measurable from
  `path (n + 1) ω = step (path n ω, ω (path n ω))`, the generation-depth
  condition, measurable root and update, and countable ranges;
  `ProbabilityTheory.BranchingRandomWalk.causal_lineage_adapted` is the
  countable-slot specialization.

`generationSpace n` is the σ-algebra generated by all marks at addresses of
depth strictly below `n`, and `generationFiltration` turns these spaces into a
filtration of the full product space. The file proves that the mark at depth
`d` is revealed at generation `d + 1`, that the current frontier is a
measurable observation, and the two random-index measurability steps used by
the restart and reserve arguments: `selected_mark_measurable` for an address
chosen from generation-`n` information, and `causal_lineage_adapted` for an
unconditionally pre-defined lineage that extends one generation at a time.
The adapted-state corollary `frontier_causal_state_adapted` is proved in
`Probability/BranchingRandomWalk/Timing/Schedule/Frontier.lean`, since it needs the restart lemmas.
-/

open MeasureTheory

@[expose] public section

namespace ProbabilityTheory.BranchingRandomWalk

open Combinatorics.UlamHarris MeasureTheory



variable {M : Type*} [MeasurableSpace M]

variable {α : Type*}

/-- Node addresses carry the discrete σ-algebra. -/
instance instMeasurableSpaceTreeNode (α : Type*) : MeasurableSpace (TreeNode α) := ⊤

/-- The generation information forms a filtration of the full product space.
A mark at depth `d` is first revealed at time `d + 1`. -/
def generationFiltration :
    Filtration ℕ (inferInstance : MeasurableSpace (Mark α M)) :=
  Filtration.generatedByCoordinates
    (fun u : TreeNode α => u.length + 1)
    (fun u (ω : Mark α M) => ω u)
    (fun u => measurable_pi_apply u)

/-- Information revealed by generation `n`: all marks at addresses of
  depth strictly below `n`. -/
@[instance_reducible] def generationSpace (n : ℕ) :
    MeasurableSpace (Mark α M) :=
  generationFiltration (M := M) n

/-- Before the root reproduces, no child mark is revealed. -/
theorem generationSpace_zero :
    generationSpace (α := α) (M := M) 0 = ⊥ := by
  change (⨆ u : TreeNode α, ⨆ (_ : u.length + 1 ≤ 0),
    MeasurableSpace.comap (fun ω : Mark α M => ω u) inferInstance) = ⊥
  apply le_antisymm
  · apply iSup_le
    intro u
    apply iSup_le
    intro hu
    simp at hu
  · exact bot_le

/-- A node's mark is observable from the next generation onward. -/
theorem mark_measurable_of_depth_lt (u : TreeNode α) (n : ℕ)
    (hu : u.length < n) :
    Measurable[generationFiltration (M := M) n]
      (fun ω : Mark α M => ω u) := by
  exact Filtration.measurable_coordinate_generatedByCoordinates
    (fun u : TreeNode α => u.length + 1)
    (fun u (ω : Mark α M) => ω u)
    (fun u => measurable_pi_apply u) u n (Nat.succ_le_iff.mpr hu)

theorem mark_measurable_next (u : TreeNode α) :
    Measurable[generationFiltration (M := M) (u.length + 1)]
      (fun ω : Mark α M => ω u) :=
  mark_measurable_of_depth_lt u _ (Nat.lt_succ_self _)

/-- Only marks of parents in generation `n` are supplied to a generation
update. All deeper marks are hidden behind a dummy value. -/
def frontierMarks [Inhabited M] (n : ℕ)
    (ω : Mark α M) : Mark α M :=
  fun u => if u.length = n then ω u else default

/-- The entire current frontier, regarded as a product-valued observation, is
measurable when generation `n + 1` has been exposed. -/
theorem frontierMarks_measurable [Inhabited M] (n : ℕ) :
    Measurable[generationFiltration (α := α) (M := M) (n + 1)]
      (frontierMarks (α := α) (M := M) n) := by
  apply (@measurable_pi_iff (Mark α M) (TreeNode α) (fun _ => M)
    (generationFiltration (α := α) (M := M) (n + 1))
    (fun _ => inferInstance) (frontierMarks (α := α) (M := M) n)).2
  intro u
  by_cases hu : u.length = n
  · simpa [frontierMarks, hu] using
      (mark_measurable_of_depth_lt u (n + 1)
        (by rw [hu]; exact Nat.lt_succ_self n))
  · simp [frontierMarks, hu]

/-- A node selected using generation-`n` information has an observable mark
when the selector has countable range and always points below generation `n`.
Only the addresses that can actually be selected are enumerated; the ambient
slot type may be uncountable. -/
theorem selected_mark_measurable_of_countable_range (n : ℕ)
    (chosen : Mark α M → TreeNode α)
    (hchosen : Measurable[generationFiltration (M := M) n] chosen)
    (hdepth : ∀ ω, (chosen ω).length < n)
    (hcount : (Set.range chosen).Countable) :
    Measurable[generationFiltration (M := M) n]
      (fun ω : Mark α M => ω (chosen ω)) := by
  let _ : MeasurableSpace (Mark α M) := generationFiltration (M := M) n
  exact Measurable.eval_of_countable_range
    (fun ω u => ω u) chosen
    (fun u hu => by
      have hdepth' : u.length < n := by
        obtain ⟨ω, hω⟩ := hu
        simpa [← hω] using hdepth ω
      exact mark_measurable_of_depth_lt u n hdepth')
    (fun u _ => hchosen (measurableSet_singleton u)) hcount

/-- Countable offspring labels are a convenient sufficient condition for the
range condition in `selected_mark_measurable_of_countable_range`. -/
theorem selected_mark_measurable [Countable α] (n : ℕ)
    (chosen : Mark α M → TreeNode α)
    (hchosen : Measurable[generationFiltration (M := M) n] chosen)
    (hdepth : ∀ ω, (chosen ω).length < n) :
    Measurable[generationFiltration (M := M) n]
      (fun ω : Mark α M => ω (chosen ω)) :=
  selected_mark_measurable_of_countable_range n chosen hchosen hdepth
    (Set.to_countable (Set.range chosen))

/-- An unconditionally pre-defined lineage that extends one generation at a
time from its own currently revealed mark is adapted. The premise about
length rules out a retrospectively chosen ancestor. -/
theorem causal_lineage_adapted_of_countable_range
    (path : ℕ → Mark α M → TreeNode α)
    (step : TreeNode α × M → TreeNode α)
    (hstep : Measurable step)
    (hroot : Measurable[generationFiltration (M := M) 0] (path 0))
    (hdepth : ∀ n ω, (path n ω).length = n)
    (hrec : ∀ n ω, path (n + 1) ω =
      step (path n ω, ω (path n ω)))
    (hcount : ∀ n, (Set.range (path n)).Countable) :
    ∀ n, Measurable[generationFiltration (M := M) n] (path n) := by
  intro n
  induction n with
  | zero => exact hroot
  | succ n ih =>
      have hold : Measurable[generationFiltration (M := M) (n + 1)]
          (path n) :=
        ih.mono (generationFiltration (M := M) |>.mono (Nat.le_succ n)) le_rfl
      have hmark : Measurable[generationFiltration (M := M) (n + 1)]
          (fun ω : Mark α M => ω (path n ω)) :=
        selected_mark_measurable_of_countable_range (n + 1) (path n) hold
          (fun ω => by rw [hdepth n ω]; exact Nat.lt_succ_self n)
          (hcount n)
      have hpair : Measurable[generationFiltration (M := M) (n + 1)]
          (fun ω : Mark α M => (path n ω, ω (path n ω))) :=
        hold.prodMk hmark
      convert hstep.comp hpair using 1
      funext ω
      exact hrec n ω

/-- The traditional countable-slot statement follows from the precise
countable-range interface. -/
theorem causal_lineage_adapted [Countable α]
    (path : ℕ → Mark α M → TreeNode α)
    (step : TreeNode α × M → TreeNode α)
    (hstep : Measurable step)
    (hroot : Measurable[generationFiltration (M := M) 0] (path 0))
    (hdepth : ∀ n ω, (path n ω).length = n)
    (hrec : ∀ n ω, path (n + 1) ω =
      step (path n ω, ω (path n ω))) :
    ∀ n, Measurable[generationFiltration (M := M) n] (path n) :=
  causal_lineage_adapted_of_countable_range path step hstep hroot hdepth hrec
    fun n => Set.to_countable (Set.range (path n))

end ProbabilityTheory.BranchingRandomWalk
