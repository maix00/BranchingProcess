module

public import Mathlib.Probability.Process.Filtration
public import Probability.Sequence.Block

/-!
# Strict-prefix filtration of a sequence

For a sequence $x : \mathbb{N}\to E$, let $\mathcal{F}_n$ be the σ-algebra
generated by $x_0,\ldots,x_{n-1}$. This construction is independent of any
interpretation of the coordinates as increments or states of a particular
process. It works for an arbitrary measurable coordinate space. Mathlib's
`Filtration.piLE` includes coordinates up to and including its time index,
while `Filtration.natural` assumes strongly measurable process coordinates;
this definition records the strict finite prefix used by block-coordinate
maps without a topological structure on `E`.

## Public declarations

* `sequencePrefixFiltration` defines $\mathcal{F}_n=\sigma(x_0,\ldots,x_{n-1})$.
* `sequencePrefixFiltration_eq_comap_blockCoordinates` identifies
  $\mathcal{F}_n$ with the comap of the map $x\mapsto(x_k)_{k<n}$.
* `sequenceCoordinate_measurable` states that each $x_k$, for $k<n$, is
  measurable with respect to $\mathcal{F}_n$.
-/

open MeasureTheory

@[expose] public section

namespace ProbabilityTheory

variable {E : Type*} [MeasurableSpace E]

/-- Sigma-algebra generated by the first `n` coordinate evaluations. -/
def sequencePrefixFiltration : Filtration ℕ (inferInstance : MeasurableSpace (ℕ → E)) where
  seq n := ⨆ k : Fin n,
    MeasurableSpace.comap (fun sequence : ℕ → E ↦ sequence (k : ℕ)) inferInstance
  mono' n m hnm := by
    refine iSup_le fun k ↦ ?_
    let k' : Fin m := ⟨k, lt_of_lt_of_le k.isLt hnm⟩
    simpa [k'] using le_iSup
      (fun j : Fin m ↦ MeasurableSpace.comap
        (fun sequence : ℕ → E ↦ sequence (j : ℕ)) inferInstance) k'
  le' n := by
    refine iSup_le fun k ↦ ?_
    exact (measurable_pi_apply (k : ℕ)).comap_le

/-- The prefix filtration is exactly the domain of its finite-coordinate map. -/
theorem sequencePrefixFiltration_eq_comap_blockCoordinates (n : ℕ) :
    sequencePrefixFiltration (E := E) n =
      MeasurableSpace.comap
        (Combinatorics.Sequence.blockCoordinates 0 n) inferInstance := by
  simp only [sequencePrefixFiltration, MeasurableSpace.pi,
    MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  apply iSup_congr
  intro k
  congr 1
  funext sequence
  simp [Combinatorics.Sequence.blockCoordinates]

/-- Each coordinate exposed by the time-`n` prefix is measurable with respect
to the prefix filtration at time `n`. -/
theorem sequenceCoordinate_measurable (n : ℕ) (k : Fin n) :
    Measurable[sequencePrefixFiltration (E := E) n]
      (fun sequence : ℕ → E => sequence k) := by
  rw [measurable_iff_comap_le]
  exact le_iSup
    (fun j : Fin n => MeasurableSpace.comap
      (fun sequence : ℕ → E => sequence (j : ℕ)) inferInstance) k

end ProbabilityTheory

end
