module

public import Probability.BranchingProcess.State.Descendants.Generation
public import Probability.BranchingProcess.State.Kernel
public import Probability.Kernel.IonescuTulcea.Independent
public import Probability.Kernel.IonescuTulcea.Map

/-!
# Complete descendant path laws for state-dependent branching

## Public declarations

* `ProbabilityTheory.BranchingProcess.State.traj_descendantPaths`: after a
  specified history through generation $a$, the complete descendant paths
  from distinct addresses $(r_i,u_i)$ have joint law
  $\bigotimes_i P_{s(r_i,u_i)}$. Here $P_x$ is the single-root path law
  generated by the same state-dependent offspring kernel $K$, started at $x$.

The proof identifies the initial and one-step laws of the descendant
projection, and applies finite-history uniqueness. The independent
one-generation identity extends to the full path sigma algebra by the
projective-limit uniqueness in Mathlib's Ionescu--Tulcea construction.
-/

@[expose] public section

open MeasureTheory Combinatorics.Branching Finset Preorder

namespace ProbabilityTheory.BranchingProcess.State

/-- Conditional on a specified finite history, the entire descendant paths of
 distinct current nodes are independent, with their respective current-state laws. -/
theorem traj_descendantPaths {Root ι α S : Type*} [MeasurableSpace S]
    (K : Kernel S (Step α S)) [IsMarkovKernel K] (a : ℕ)
    (history : Π k : Iic a, (Root × (Fin k.1 → α)) → Option S)
    (roots : ι → Root × (Fin a → α)) (hinj : Function.Injective roots) :
    (Kernel.traj (X := fun n : ℕ ↦ (Root × (Fin n → α)) → Option S)
      (generationHistoryKernel (Root := Root) K) a history).map
        (fun x n i (p : Unit × (Fin n → α)) ↦
          x (a + n) ((roots i).1, Fin.append (roots i).2 p.2)) =
      (Measure.infinitePi (fun i ↦ pathKernel K (history ⟨a, by simp⟩ (roots i)))).map
        (fun paths n i ↦ paths i n) := by
  let κ := fun _ : ι ↦ generationHistoryKernel (Root := Unit) K
  have : ∀ i n, IsMarkovKernel (κ i n) := fun _ _ ↦ inferInstance
  have : ∀ n, IsMarkovKernel (Kernel.independentHistoryKernel
      (X := fun (_ : ι) (n : ℕ) ↦ (Unit × (Fin n → α)) → Option S) κ n) :=
    fun n ↦ Kernel.independentHistoryKernel.isMarkovKernel
      (X := fun (_ : ι) (n : ℕ) ↦ (Unit × (Fin n → α)) → Option S) κ n
  let s := fun i ↦ history ⟨a, by simp⟩ (roots i)
  have hcomponent (i : ι) : pathKernel K (s i) =
      Kernel.trajMeasure (Measure.dirac (fun _ : Unit × (Fin 0 → α) ↦ s i)) (κ i) := by
    rw [pathKernel_eq_generationPathLaw, generationPathLaw,
      Measure.map_dirac' (by fun_prop)]
  change _ = (Measure.infinitePi (fun i ↦ pathKernel K (s i))).map _
  simp_rw [hcomponent]
  rw [Kernel.trajMeasure_infinitePi, Measure.infinitePi_dirac]
  rw [Kernel.map_traj_eq_trajMeasure
    (X := fun n : ℕ ↦ (Root × (Fin n → α)) → Option S)
    (Y := fun n : ℕ ↦ ι → (Unit × (Fin n → α)) → Option S)
    (generationHistoryKernel (Root := Root) K) (Kernel.independentHistoryKernel
      (X := fun (_ : ι) (n : ℕ) ↦ (Unit × (Fin n → α)) → Option S) κ)
    a history
    (fun n (x : (Root × (Fin (a + n) → α)) → Option S) i
      (p : Unit × (Fin n → α)) ↦ x ((roots i).1, Fin.append (roots i).2 p.2))
    (fun _ ↦ by fun_prop)]
  · congr 2
    funext i p
    change history ⟨a, by simp⟩ ((roots i).1, Fin.append (m := a) (n := 0) (roots i).2 p.2) = _
    congr 2
    funext j
    exact Fin.append_left (roots i).2 p.2 j
  · intro n h
    exact generationKernel_descendants K a n roots hinj (h ⟨a + n, by simp⟩)

end ProbabilityTheory.BranchingProcess.State
