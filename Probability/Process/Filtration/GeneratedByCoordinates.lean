module

public import Mathlib.Probability.Process.Filtration

/-!
# Filtrations generated by graded observations

For observations `X i : Ω → E i` revealed at grades `grade i`,
`MeasureTheory.Filtration.generatedByCoordinates` defines

`𝓕_t = ⨆_{i : I} ⨆_{grade i ≤ t},
MeasurableSpace.comap (X_i) m_{E_i}`.

The public declarations are:

* `MeasureTheory.Filtration.generatedByCoordinates grade coordinate hcoordinate`
  defines the filtration by the displayed formula, assuming each coordinate
  is measurable in the ambient measurable space.
* `MeasureTheory.Filtration.measurable_coordinate_generatedByCoordinates`
  states that `coordinate i` is measurable at time `t` whenever
  `grade i ≤ t`.
* `MeasureTheory.Filtration.generatedByCoordinates_le` states that this is the
  least filtration making each `coordinate i` measurable at `grade i`.
* `MeasureTheory.Filtration.measurable_to_generatedByCoordinates` states that
  a map `f : Ω → Ω'` into this filtration is measurable at time `t` if each
  currently available coordinate `coordinate i ∘ f` is measurable.
* `MeasureTheory.Filtration.measurable_iff_coordinates_generatedByCoordinates`
  gives the converse as well, characterizing measurability into the generated
  σ-algebra exactly by its coordinate maps.

The construction allows an arbitrary preorder of times and arbitrary
dependent measurable observation spaces.
-/

@[expose] public section

namespace MeasureTheory
namespace Filtration

/-- The filtration generated by observations `coordinate i` once their grades
`grade i` have been reached. -/
def generatedByCoordinates {Ω I T : Type*} {X : I → Type*}
    [MeasurableSpace Ω] [∀ i, MeasurableSpace (X i)] [Preorder T]
    (grade : I → T) (coordinate : ∀ i, Ω → X i)
    (hcoordinate : ∀ i, Measurable (coordinate i)) :
    Filtration T (inferInstance : MeasurableSpace Ω) where
  seq t := ⨆ i, ⨆ (_ : grade i ≤ t),
    MeasurableSpace.comap (coordinate i) (inferInstance : MeasurableSpace (X i))
  mono' := by
    intro t s hts
    refine iSup_le fun i => iSup_le fun hit => ?_
    exact le_iSup_of_le i (le_iSup_of_le (le_trans hit hts) le_rfl)
  le' := by
    intro t
    refine iSup_le fun i => iSup_le fun hit => ?_
    exact (hcoordinate i).comap_le

/-- An observation is measurable from any time at or after its grade. -/
theorem measurable_coordinate_generatedByCoordinates
    {Ω I T : Type*} {X : I → Type*}
    [MeasurableSpace Ω] [∀ i, MeasurableSpace (X i)] [Preorder T]
    (grade : I → T) (coordinate : ∀ i, Ω → X i)
    (hcoordinate : ∀ i, Measurable (coordinate i))
    (i : I) (t : T) (hit : grade i ≤ t) :
    @Measurable Ω (X i)
      (generatedByCoordinates grade coordinate hcoordinate t)
      inferInstance (coordinate i) := by
  apply Measurable.of_comap_le
  exact le_iSup_of_le i (le_iSup_of_le hit le_rfl)

/-- The filtration generated by graded coordinates is the least filtration
making each coordinate measurable at its grade. -/
theorem generatedByCoordinates_le
    {Ω I T : Type*} {X : I → Type*}
    [MeasurableSpace Ω] [∀ i, MeasurableSpace (X i)] [Preorder T]
    (grade : I → T) (coordinate : ∀ i, Ω → X i)
    (hcoordinate : ∀ i, Measurable (coordinate i))
    (𝓕 : Filtration T (inferInstance : MeasurableSpace Ω))
    (h𝓕 : ∀ i, Measurable[𝓕 (grade i)] (coordinate i)) :
    generatedByCoordinates grade coordinate hcoordinate ≤ 𝓕 := by
  intro t
  refine iSup_le fun i => iSup_le fun hit => ?_
  exact le_trans (h𝓕 i).comap_le (𝓕.mono hit)

/-- A map into a filtration generated by coordinates is measurable once its
composition with every coordinate available at the current time is measurable.
-/
theorem measurable_to_generatedByCoordinates
    {Ω Ω' I T : Type*} {X : I → Type*}
    [MeasurableSpace Ω] [MeasurableSpace Ω'] [∀ i, MeasurableSpace (X i)]
    [Preorder T]
    (grade : I → T) (coordinate : ∀ i, Ω' → X i)
    (hcoordinate : ∀ i, Measurable (coordinate i))
    (f : Ω → Ω') (t : T)
    (h : ∀ i, grade i ≤ t → Measurable (coordinate i ∘ f)) :
    @Measurable Ω Ω'
      (inferInstance : MeasurableSpace Ω)
      (generatedByCoordinates grade coordinate hcoordinate t) f := by
  rw [measurable_iff_comap_le]
  change (⨆ i, ⨆ (_ : grade i ≤ t),
    MeasurableSpace.comap (coordinate i) inferInstance).comap f ≤ _
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun i => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hit => ?_
  rw [MeasurableSpace.comap_comp]
  exact (h i hit).comap_le

/-- A map into a filtration generated by coordinates is measurable exactly
when all coordinates available at the current time are measurable after
composition with that map. -/
theorem measurable_iff_coordinates_generatedByCoordinates
    {Ω Ω' I T : Type*} {X : I → Type*}
    [MeasurableSpace Ω] [MeasurableSpace Ω'] [∀ i, MeasurableSpace (X i)]
    [Preorder T]
    (grade : I → T) (coordinate : ∀ i, Ω' → X i)
    (hcoordinate : ∀ i, Measurable (coordinate i))
    (f : Ω → Ω') (t : T) :
    @Measurable Ω Ω'
      (inferInstance : MeasurableSpace Ω)
      (generatedByCoordinates grade coordinate hcoordinate t) f ↔
      ∀ i, grade i ≤ t → Measurable (coordinate i ∘ f) := by
  constructor
  · intro hf i hit
    exact (measurable_coordinate_generatedByCoordinates
      grade coordinate hcoordinate i t hit).comp hf
  · exact measurable_to_generatedByCoordinates
      grade coordinate hcoordinate f t

end Filtration
end MeasureTheory
