module

public import Combinatorics.UlamHarris.Line.Order
public import Mathlib.MeasureTheory.MeasurableSpace.Constructions
public import Probability.Process.Filtration.GeneratedByCoordinates

/-!
# Information before lines and along ancestral paths

## Public declarations

In `ProbabilityTheory.Tree`, let `initial` be the initial information and
`coordinate v` the sigma algebra of the reproduction observation at node `v`.

* `linePast initial coordinate ℓ = initial ⊔ ⨆ v ∉ D_ℓ, coordinate v`, where
  `D_ℓ = RootIndexed.Line.descendantClosure ℓ` includes the line itself.
* `ancestralPast initial coordinate u` joins `initial` with `coordinate v`
  over strict ancestors `v ≺ u`, available at the birth of `u` in the
  discrete one-reproduction-per-generation model.
* `coordinate_le_linePast` makes an observation available when `v ∉ D_ℓ`.
  `coordinate_le_ancestralPast` gives the strict-ancestor observation rule.
* `ancestralPast_mono` states `u ≼ v → ancestralPast u ≤ ancestralPast v`.
* `linePast_mono` states `ℓ ≼ q → linePast ℓ ≤ linePast q`.
* `ancestralPast_le_linePast` states that if `u ≼ v ∈ ℓ` and `ℓ` is a line,
  then the strict ancestral information at `u` lies in `linePast ℓ`.
* `linePast_empty` identifies the empty-line past with all coordinate information.
* `linePast_generation` identifies the generation-`n` past with
  `initial ⊔ ⨆ |v.2| < n, coordinate v`.
* `linePast_generation_eq_generatedByCoordinates` identifies its observation-generated
  specialization with Mathlib `Filtration` via the existing
  `Filtration.generatedByCoordinates`, with observation grade `|v.2| + 1`.
* `linePast_le` and `ancestralPast_le` bound these spaces by any ambient
  sigma algebra containing the initial and coordinate information.

Roots, child indices, and observations are unrestricted; independence and
countability are unnecessary here. A branch never cut by `ℓ` contributes
its complete observation history to `linePast ℓ`.

The line-past convention follows the optional-line framework in J. D. Biggins
and A. E. Kyprianou, *Measure change in multitype branching* (2004), §6,
pp. 556–557, [DOI:10.1239/aap/1086957585](https://doi.org/10.1239/aap/1086957585).
Here `coordinate v` means the sigma algebra generated by that parent's
reproduction observation, not the parent's birth state. In a life-space
realization `π_v : Ω → Life v`, this is `MeasurableSpace.comap π_v _` when
`π_v` records exactly the required reproduction data. Life spaces and
observations use native measurable spaces and maps; no extra life-space type
is introduced. `Information/Observations.lean` handles alternative observable
representations and inclusive ancestral state observations.
-/

@[expose] public section

namespace ProbabilityTheory.Tree

open MeasureTheory Combinatorics.UlamHarris

variable {Ω Root α : Type*}

/-- Initial information and all reproduction observations outside the line's descendant closure. -/
@[instance_reducible] def linePast (initial : MeasurableSpace Ω)
    (coordinate : RootIndexed.TreeNode Root α → MeasurableSpace Ω)
    (ℓ : Set (RootIndexed.TreeNode Root α)) : MeasurableSpace Ω :=
  initial ⊔ ⨆ v, ⨆ (_ : v ∉ RootIndexed.Line.descendantClosure ℓ), coordinate v

/-- Information on the ancestral path before the specified node reproduces. -/
@[instance_reducible] def ancestralPast (initial : MeasurableSpace Ω)
    (coordinate : RootIndexed.TreeNode Root α → MeasurableSpace Ω)
    (u : RootIndexed.TreeNode Root α) : MeasurableSpace Ω :=
  initial ⊔ ⨆ v, ⨆ (_ : RootIndexed.IsAncestor v u ∧ v ≠ u), coordinate v

variable (initial : MeasurableSpace Ω)
  (coordinate : RootIndexed.TreeNode Root α → MeasurableSpace Ω)

theorem coordinate_le_linePast {ℓ : Set (RootIndexed.TreeNode Root α)}
    {v : RootIndexed.TreeNode Root α} (hv : v ∉ RootIndexed.Line.descendantClosure ℓ) :
    coordinate v ≤ linePast initial coordinate ℓ :=
  le_sup_of_le_right (le_iSup_of_le v (le_iSup_of_le hv le_rfl))

theorem coordinate_le_ancestralPast {v u : RootIndexed.TreeNode Root α}
    (hvu : RootIndexed.IsAncestor v u) (hne : v ≠ u) :
    coordinate v ≤ ancestralPast initial coordinate u :=
  le_sup_of_le_right (le_iSup_of_le v (le_iSup_of_le ⟨hvu, hne⟩ le_rfl))

/-- Birth information increases along an ancestral path. -/
theorem ancestralPast_mono {u v : RootIndexed.TreeNode Root α}
    (huv : RootIndexed.IsAncestor u v) :
    ancestralPast initial coordinate u ≤ ancestralPast initial coordinate v := by
  refine sup_le le_sup_left (iSup_le fun w => iSup_le fun hw => ?_)
  apply coordinate_le_ancestralPast initial coordinate (hw.1.trans huv)
  intro heq
  have hvu : RootIndexed.IsAncestor v u := heq ▸ hw.1
  exact hw.2 (heq.trans (huv.antisymm hvu).symm)

theorem linePast_mono {ℓ q : Set (RootIndexed.TreeNode Root α)}
    (h : RootIndexed.Line.Precedes ℓ q) :
    linePast initial coordinate ℓ ≤ linePast initial coordinate q := by
  refine sup_le le_sup_left (iSup_le fun v => iSup_le fun hv => ?_)
  apply coordinate_le_linePast initial coordinate
  rintro ⟨w, hw, hwv⟩
  obtain ⟨u, hu, huw⟩ := h w hw
  exact hv ⟨u, hu, huw.trans hwv⟩

theorem ancestralPast_le_linePast {ℓ : Set (RootIndexed.TreeNode Root α)}
    (hℓ : RootIndexed.IsLine ℓ) {u v : RootIndexed.TreeNode Root α}
    (hv : v ∈ ℓ) (huv : RootIndexed.IsAncestor u v) :
    ancestralPast initial coordinate u ≤ linePast initial coordinate ℓ := by
  refine sup_le le_sup_left (iSup_le fun w => iSup_le fun hw => ?_)
  apply coordinate_le_linePast initial coordinate
  rintro ⟨q, hq, hqw⟩
  have hqv : q = v := hℓ.eq hq hv (hqw.trans (hw.1.trans huv))
  subst q
  have huw : RootIndexed.IsAncestor u w := huv.trans hqw
  exact hw.2 (hw.1.antisymm huw)

@[simp] theorem linePast_empty :
    linePast initial coordinate ∅ = initial ⊔ ⨆ v, coordinate v := by
  simp [linePast, RootIndexed.Line.descendantClosure]

/-- At a fixed generation the line past is exactly the observations of earlier parents. -/
theorem linePast_generation (n : ℕ) :
    linePast initial coordinate {v | v.2.length = n} =
      initial ⊔ ⨆ v, ⨆ (_ : v.2.length < n), coordinate v := by
  simp only [linePast, RootIndexed.Line.mem_descendantClosure_generation_iff, not_le]

/-- Coordinate-generated generation filtrations are the fixed-generation specialization. -/
theorem linePast_generation_eq_generatedByCoordinates
    [mΩ : MeasurableSpace Ω] {E : RootIndexed.TreeNode Root α → Type*}
    [∀ v, MeasurableSpace (E v)]
    (observation : ∀ v, Ω → E v)
    (hobs : ∀ v, @Measurable Ω (E v) mΩ inferInstance (observation v)) (n : ℕ) :
    linePast initial (fun v => MeasurableSpace.comap (observation v) inferInstance)
        {v | v.2.length = n} =
      initial ⊔ @Filtration.generatedByCoordinates Ω (RootIndexed.TreeNode Root α) ℕ E
        mΩ _ _ (fun v => v.2.length + 1) observation hobs n := by
  rw [linePast_generation]
  change initial ⊔ (⨆ v, ⨆ (_ : v.2.length < n),
      MeasurableSpace.comap (observation v) inferInstance) =
    initial ⊔ (⨆ v, ⨆ (_ : v.2.length + 1 ≤ n),
      MeasurableSpace.comap (observation v) inferInstance)
  simp only [Nat.succ_le_iff]

theorem linePast_le {m : MeasurableSpace Ω} (hi : initial ≤ m)
    (hc : ∀ v, coordinate v ≤ m) (ℓ : Set (RootIndexed.TreeNode Root α)) :
    linePast initial coordinate ℓ ≤ m :=
  sup_le hi (iSup_le fun v => iSup_le fun _ => hc v)

theorem ancestralPast_le {m : MeasurableSpace Ω} (hi : initial ≤ m)
    (hc : ∀ v, coordinate v ≤ m) (u : RootIndexed.TreeNode Root α) :
    ancestralPast initial coordinate u ≤ m :=
  sup_le hi (iSup_le fun v => iSup_le fun _ => hc v)

end ProbabilityTheory.Tree

end
