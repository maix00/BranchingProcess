module

public import Probability.Process.Tree.Line.Information.Coordinates
public import Mathlib.MeasureTheory.MeasurableSpace.Embedding

/-!
# Life observations, state observations, and their information

## Public declarations

In `ProbabilityTheory.Tree`:

* `ancestralStateInformation initial state u` is
  `initial ⊔ ⨆ v ≼ u, σ(state v)`. It includes the state at `u`.
* `ancestralStateInformation_le_ancestralPast` proves this state information
  is contained in the strict-ancestor reproduction information when every
  `state v` is measurable at the birth of `v`.
* `linePast_observation_map_le` states that a measurable observation of each
  life coordinate has information contained in that of its original record:
  `linePast initial σ(g_v ∘ X_v) ℓ ≤ linePast initial σ(X_v) ℓ`.
* `linePast_observation_equiv` proves equality for measurable re-encodings
  `e_v : E v ≃ᵐ E' v`. Thus they provide different representations of the
  same deterministic-line information and the same optional-line predicate.

Here `Ω` is the whole model's sample domain; `E v` can be the individual
life space `Ω_v`. A life coordinate is a map `X v : Ω → E v`; its sigma
algebra is the native `MeasurableSpace.comap (X v) _`. The type `E v`, an
individual record `X v ω`, and the information generated by that record are
three different objects. No extra life-space or population-space structure
is needed beyond native measurable spaces and observation maps.
A mark may itself contain a complete life record, including lifetime, birth
ages and offspring. The distinction is the observation carried by each
coordinate, rather than a separate foundational type for lives and marks.
In a one-reproduction model the existing `Step α Mark` records an entire
parental offspring branch; an individual child mark is one component of it.

P. Jagers and O. Nerman, *The asymptotic composition of supercritical,
multi-type branching populations* (1996), §2, p. 41,
[Numdam](https://www.numdam.org/item/SPS_1996__30__40_0/), define individual
life spaces as measurable carriers of birth ages and offspring types.
J. D. Biggins and A. E. Kyprianou, *Measure change in multitype branching*
(2004), §6, p. 557, [DOI:10.1239/aap/1086957585](https://doi.org/10.1239/aap/1086957585),
use inclusive ancestral state observations in their very-simple optional-line
condition. State observations may discard reproduction marks, so their
information is compared by inclusion, with equality only under an appropriate
information-preservation hypothesis.
-/

@[expose] public section

namespace ProbabilityTheory.Tree

open MeasureTheory Combinatorics.UlamHarris

variable {Ω Root α : Type*}

/-- Initial information and the observed states along the ancestry, including the current state. -/
@[instance_reducible] def ancestralStateInformation
    {E : RootIndexed.TreeNode Root α → Type*} [∀ v, MeasurableSpace (E v)]
    (initial : MeasurableSpace Ω) (state : ∀ v, Ω → E v)
    (u : RootIndexed.TreeNode Root α) : MeasurableSpace Ω :=
  initial ⊔ ⨆ v, ⨆ (_ : RootIndexed.IsAncestor v u),
    MeasurableSpace.comap (state v) inferInstance

/-- Birth-state observations, including the current state, use only earlier reproduction. -/
theorem ancestralStateInformation_le_ancestralPast
    {E : RootIndexed.TreeNode Root α → Type*} [∀ v, MeasurableSpace (E v)]
    (initial : MeasurableSpace Ω)
    (coordinate : RootIndexed.TreeNode Root α → MeasurableSpace Ω)
    (state : ∀ v, Ω → E v)
    (hstate : ∀ v, Measurable[ancestralPast initial coordinate v] (state v))
    (u : RootIndexed.TreeNode Root α) :
    ancestralStateInformation initial state u ≤ ancestralPast initial coordinate u := by
  refine sup_le le_sup_left (iSup_le fun v => iSup_le fun hv => ?_)
  exact (hstate v).comap_le.trans (ancestralPast_mono initial coordinate hv)

/-- Applying a measurable observation to individual records gives a sub-sigma-algebra. -/
theorem linePast_observation_map_le
    {E E' : RootIndexed.TreeNode Root α → Type*}
    [∀ v, MeasurableSpace (E v)] [∀ v, MeasurableSpace (E' v)]
    (initial : MeasurableSpace Ω) (record : ∀ v, Ω → E v)
    (observation : ∀ v, E v → E' v) (hobs : ∀ v, Measurable (observation v))
    (ℓ : Set (RootIndexed.TreeNode Root α)) :
    linePast initial (fun v => MeasurableSpace.comap (observation v ∘ record v) inferInstance) ℓ ≤
      linePast initial (fun v => MeasurableSpace.comap (record v) inferInstance) ℓ := by
  refine sup_le le_sup_left (iSup_le fun v => iSup_le fun hv => ?_)
  apply le_trans _ (coordinate_le_linePast initial _ hv)
  change MeasurableSpace.comap (observation v ∘ record v) _ ≤
    MeasurableSpace.comap (record v) _
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (hobs v).comap_le

/-- A measurable re-encoding preserves the observation sigma algebra at every line. -/
theorem linePast_observation_equiv
    {E E' : RootIndexed.TreeNode Root α → Type*}
    [∀ v, MeasurableSpace (E v)] [∀ v, MeasurableSpace (E' v)]
    (initial : MeasurableSpace Ω) (record : ∀ v, Ω → E v)
    (encoding : ∀ v, E v ≃ᵐ E' v)
    (ℓ : Set (RootIndexed.TreeNode Root α)) :
    linePast initial (fun v =>
      MeasurableSpace.comap (encoding v ∘ record v) inferInstance) ℓ =
      linePast initial (fun v => MeasurableSpace.comap (record v) inferInstance) ℓ := by
  have hcoordinate : (fun v =>
      MeasurableSpace.comap (encoding v ∘ record v) inferInstance) =
        (fun v => MeasurableSpace.comap (record v) inferInstance) := by
    funext v
    rw [← MeasurableSpace.comap_comp, (encoding v).measurableEmbedding.comap_eq]
  rw [hcoordinate]

end ProbabilityTheory.Tree

end
