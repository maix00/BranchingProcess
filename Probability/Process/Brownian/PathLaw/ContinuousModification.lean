module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.Probability.BrownianMotion.Basic
import Probability.Process.Path.Representation.Continuous

/-!
# Continuous path versions of Brownian processes

## Public declarations

- `ProbabilityTheory.IsBrownianReal.exists_measurable_continuousPathMap`:
  for measurable Brownian coordinates $B_t$, there is a measurable
  $Y:\Omega\to C(\mathbb R_{\ge 0},\mathbb R)$ such that
  $Y(\omega)(t)=B_t(\omega)$ for every $t$, almost surely.
- `ProbabilityTheory.IsBrownianReal.continuousPathMap`:
  the selected measurable continuous-path-valued representative $Y$.
- `ProbabilityTheory.IsBrownianReal.measurable_continuousPathMap` and
  `ProbabilityTheory.IsBrownianReal.continuousPathMap_ae_eq`:
  measurability of $Y$ and its simultaneous almost-sure coordinate identity.

The construction uses the Borel structure on continuous maps, which is
generated by coordinate evaluations, and the almost-sure continuity in
the definition of a Brownian process.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal

namespace ProbabilityTheory

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
  {B : ℝ≥0 → Ω → ℝ}

/-- A Brownian process with almost surely continuous paths has a
measurable continuous-map-valued version. -/
theorem IsBrownianReal.exists_measurable_continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ∃ X : Ω → C(ℝ≥0, ℝ), Measurable X ∧
      ∀ᵐ ω ∂P, ∀ t, X ω t = B t ω := by
  exact exists_measurable_continuousPathVersion B hB.cont hBmeasurable

/-- A measurable continuous-map-valued representative of a Brownian path.
On the null set of discontinuous samples, it is selected measurably from
the full-measure set of continuous paths. -/
noncomputable def IsBrownianReal.continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    Ω → C(ℝ≥0, ℝ) :=
  Classical.choose (hB.exists_measurable_continuousPathMap hBmeasurable)

/-- Every coordinate evaluation of the selected path is measurable. -/
theorem IsBrownianReal.measurable_continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    Measurable (hB.continuousPathMap hBmeasurable) :=
  (Classical.choose_spec (hB.exists_measurable_continuousPathMap hBmeasurable)).1

/-- Almost surely, the selected continuous path agrees with the original
Brownian sample path at every time. -/
theorem IsBrownianReal.continuousPathMap_ae_eq
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ∀ᵐ ω ∂P, ∀ t, hB.continuousPathMap hBmeasurable ω t = B t ω :=
  (Classical.choose_spec (hB.exists_measurable_continuousPathMap hBmeasurable)).2

end ProbabilityTheory

end
