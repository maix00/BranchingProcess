module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.Probability.BrownianMotion.Basic

/-!
# Continuous path versions of Brownian processes

The public objects and theorems in this file are:

- `ProbabilityTheory.IsBrownianReal.continuousPathMap`:
  a measurable random variable with values in $C([0,\infty),\mathbb R)$
  that represents the paths of a Brownian process almost surely.
  The construction takes measurable time coordinates as input.
- `ProbabilityTheory.IsBrownianReal.measurable_continuousPathMap`:
  the continuous-path-valued random variable is measurable.
- `ProbabilityTheory.IsBrownianReal.continuousPathMap_ae_eq`:
  almost surely, its path agrees at every time with the original process.
- `ProbabilityTheory.IsBrownianReal.continuousModification`:
  the process given by evaluating this path-valued random variable.
- `ProbabilityTheory.IsBrownianReal.exists_measurable_continuousPathMap`:
  existence of a measurable continuous-map-valued version.
- `ProbabilityTheory.IsBrownianReal.isBrownianReal_continuousModification`:
  the continuous modification again satisfies the Brownian process
  specification.

The construction uses the Borel structure on continuous maps, which is
generated by coordinate evaluations, and the almost-sure continuity in
the definition of a Brownian process.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal

namespace ProbabilityTheory

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
  {B : ℝ≥0 → Ω → ℝ}

/-- A Brownian process with almost surely continuous paths has a
measurable continuous-map-valued version. -/
theorem IsBrownianReal.exists_measurable_continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ∃ X : Ω → C(ℝ≥0, ℝ), Measurable X ∧
      ∀ᵐ ω ∂P, ∀ t, X ω t = B t ω := by
  let raw : Ω → ℝ≥0 → ℝ := fun ω t => B t ω
  have hraw : Measurable raw :=
    measurable_pi_iff.mpr fun t => hBmeasurable t
  obtain ⟨g, hgMeas, hgContinuous, hrawEq⟩ :=
    hraw.aemeasurable.exists_ae_eq_range_subset hB.cont
      ⟨fun _ : ℝ≥0 => (0 : ℝ), continuous_const⟩
  let gContinuous : Ω → {f : ℝ≥0 → ℝ // Continuous f} :=
    fun ω => ⟨g ω, hgContinuous (Set.mem_range_self ω)⟩
  have hgContinuousMeas : Measurable gContinuous :=
    Measurable.subtype_mk hgMeas
  let pathEquiv := MeasurableEquiv.continuousMapToFun ℝ≥0 ℝ
  refine ⟨fun ω => pathEquiv.symm (gContinuous ω),
    pathEquiv.symm.measurable.comp hgContinuousMeas, ?_⟩
  filter_upwards [hrawEq] with ω hω
  intro t
  change g ω t = B t ω
  exact (congrFun hω t).symm

/-- A measurable continuous-map-valued representative of a Brownian path.
On the null set of discontinuous samples, it is selected measurably from
the full-measure set of continuous paths. -/
noncomputable def IsBrownianReal.continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    Ω → C(ℝ≥0, ℝ) :=
  Classical.choose (hB.exists_measurable_continuousPathMap hBmeasurable)

/-- Every coordinate evaluation of the selected path is measurable. -/
theorem IsBrownianReal.measurable_continuousPathMap
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    Measurable (hB.continuousPathMap hBmeasurable) :=
  (Classical.choose_spec (hB.exists_measurable_continuousPathMap hBmeasurable)).1

/-- Almost surely, the selected continuous path agrees with the original
Brownian sample path at every time. -/
theorem IsBrownianReal.continuousPathMap_ae_eq
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ∀ᵐ ω ∂P, ∀ t, hB.continuousPathMap hBmeasurable ω t = B t ω :=
  (Classical.choose_spec (hB.exists_measurable_continuousPathMap hBmeasurable)).2

/-- The process obtained by evaluating the measurable continuous path. -/
noncomputable def IsBrownianReal.continuousModification
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ℝ≥0 → Ω → ℝ :=
  fun t ω => hB.continuousPathMap hBmeasurable ω t

/-- The path-valued version gives measurable time coordinates. -/
theorem IsBrownianReal.measurable_continuousModification
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t))
    (t : ℝ≥0) :
    Measurable (hB.continuousModification hBmeasurable t) := by
  exact (ContinuousMap.measurable_eval t).comp
    (hB.measurable_continuousPathMap hBmeasurable)

/-- The selected process has continuous paths for every sample. -/
theorem IsBrownianReal.continuous_continuousModification
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t))
    (ω : Ω) :
    Continuous (hB.continuousModification hBmeasurable · ω) :=
  (hB.continuousPathMap hBmeasurable ω).continuous

/-- The selected process is almost surely equal to the original process
simultaneously at all times. -/
theorem IsBrownianReal.continuousModification_ae_eq
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    ∀ᵐ ω ∂P, ∀ t, hB.continuousModification hBmeasurable t ω = B t ω :=
  hB.continuousPathMap_ae_eq hBmeasurable

/-- Replacing a Brownian process by its continuous path version preserves
its Brownian law. -/
theorem IsBrownianReal.isBrownianReal_continuousModification
    (hB : IsBrownianReal B P) (hBmeasurable : ∀ t, Measurable (B t)) :
    IsBrownianReal (hB.continuousModification hBmeasurable) P := by
  have hae (t : ℝ≥0) :
      (fun ω => hB.continuousModification hBmeasurable t ω) =ᵐ[P] B t := by
    filter_upwards [hB.continuousModification_ae_eq hBmeasurable] with ω hω
    exact hω t
  exact ⟨hB.toIsPreBrownianReal.congr fun t => (hae t).symm,
    ae_of_all P (hB.continuous_continuousModification hBmeasurable)⟩

end ProbabilityTheory

end
