module

public import Mathlib.Basic.Real.Basic
public import Mathlib.Algebra.Order.Floor.Ring
public import Probability.Process.RandomWalk.Path.Block.Partition.Basic
public import Probability.Process.RandomWalk.SmallDeviation.Drawdown.FiniteVarianceUpper.Lemmas.JumpPattern.SpatialBins

/-!
# Finite-prefix maximum data for the Lemma 3.3 proof

The internal constructions used by the jump-pattern proof are:

- `ProbabilityTheory.RandomWalk.SmallDeviation.Drawdown.drawdownPrefixPath`:
  the partial-sum path generated by a finite increment prefix, extended by
  zero after the prefix endpoint.
- `ProbabilityTheory.RandomWalk.SmallDeviation.Drawdown.drawdownPastDiscretizedMaximum`:
  the rounded maximum
  $U-w\lfloor(U-\max_{j\le n}S_j)/w\rfloor$ computed from the increments
  available before a block.

These are the finite-prefix maximum constructions in Wang Yiyang,
*Asymptotic Speed of the N-Branching Random Walk with Infinite Offspring*,
Chapter 3, proof of Lemma 3.3.
-/

@[expose] public section

namespace ProbabilityTheory.RandomWalk.SmallDeviation.Drawdown

/-- The finite path generated by an increment prefix. It is zero after the
prefix endpoint so its running maximum depends only on the available data. -/
def drawdownPrefixPath {start : ℕ} (past : Fin start → ℝ) : ℕ → ℝ :=
  fun time =>
    if htime : time ≤ start then
      Fin.partialSum past ⟨time, Nat.lt_succ_of_le htime⟩
    else 0

/-- The discretized maximum computed from the available finite increment
prefix, used as the center when conditioning at a block start. -/
noncomputable def drawdownPastDiscretizedMaximum {start : ℕ}
    (upper width : ℝ) (past : Fin start → ℝ) : ℝ :=
  spatialBinLevel upper width (drawdownPrefixPath past) start

end ProbabilityTheory.RandomWalk.SmallDeviation.Drawdown

end
