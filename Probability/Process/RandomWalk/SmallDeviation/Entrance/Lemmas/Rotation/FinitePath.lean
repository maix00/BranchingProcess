module

import Algebra.BigOperators.AdditivePath.Basic
import Algebra.BigOperators.PartialSum
import Algebra.BigOperators.CyclicReindex
import Probability.Process.RandomWalk.Path.Skorokhod.Basic
import Probability.Process.RandomWalk.SmallDeviation.Entrance.NormalDomainEvent
import all Probability.Process.RandomWalk.SmallDeviation.Entrance.Lemmas.Rotation.LinearTube
import Mathlib.Logic.Function.Basic
import Topology.Cadlag.Skorokhod.Path.Linear
import Mathlib.Topology.UnitInterval
import Mathlib.MeasureTheory.Constructions.BorelSpace.Order

/-!
# Finite paths for cyclic entrance estimates

## Internal proof declarations

- `ProbabilityTheory.RandomWalk.SmallDeviation.Entrance.finiteNormalizedStepPath`
  and `normalizedGridPoint`: the normalized càdlàg path and grid point $j/n$.
- `finiteNormalizedStepPath_apply_grid`: evaluation of the finite path at
  each normalized grid point, identified with the public knot map
  `finiteNormalizedStepKnots` from `Entrance/NormalDomainEvent.lean`.
- `finiteLinearPathBallEvent`: the finite vectors whose normalized path lies
  in the $J_1$ ball of radius $r$ about $t\mapsto \text{slope}\,t$.

The finite linear-path-ball event compares the path interpolation with a
fixed linear reference path.

These finite-grid path encodings implement the entrance-event construction
in Wang Yiyang, *Asymptotic Speed of the N-Branching Random Walk with Infinite
Offspring* (master's thesis, Fudan University, 2026), Appendix A.2, Lemma A.7,
used in the proof of Chapter 3, Lemma 3.5.
-/

section

open MeasureTheory ProbabilityTheory Fin
open scoped ENNReal Topology

namespace ProbabilityTheory.RandomWalk.SmallDeviation.Entrance

/-- The normalized càdlàg path generated by a finite vector of increments. -/
noncomputable def finiteNormalizedStepPath (scale : ℝ) {n : ℕ}
    (x : Fin n → ℝ) : CadlagPath unitInterval ℝ :=
  RandomWalk.normalizedStepCadlagPathIcc (fun _ => scale) n
    (Function.extend Fin.val x (fun _ => 0))

/-- The grid point `j / n` in the compact time interval, including the last
knot `j = n`. -/
noncomputable def normalizedGridPoint {n : ℕ} (hn : 0 < n) (j : Fin (n + 1)) :
    unitInterval :=
  ⟨(j.val : ℝ) / n,
    ⟨div_nonneg (Nat.cast_nonneg _) (by positivity),
      (div_le_one (by positivity)).2 (by exact_mod_cast Nat.le_of_lt_succ j.isLt)⟩⟩

/-- The first `m` increments of the finite extension sum to the corresponding
Mathlib `Fin.partialSum` knot. -/
private lemma functionExtend_fin_val_eq_piecewise {n : ℕ} (x : Fin n → ℝ) :
    Function.extend Fin.val x (fun _ => (0 : ℝ)) =
      fun m => if h : m < n then x ⟨m, h⟩ else 0 := by
  funext m
  by_cases hm : m < n
  · have hinj : Function.Injective (fun i : Fin n => i.val) :=
      fun i j hij => Fin.ext hij
    have hpoint : Function.extend Fin.val x (fun _ => 0) m = x ⟨m, hm⟩ := by
      simpa using (Function.Injective.extend_apply hinj x
        (fun _ => 0) ⟨m, hm⟩)
    simpa [hm] using hpoint
  · have hnot : ¬ ∃ i : Fin n, i.val = m := by
      rintro ⟨i, hi⟩
      exact hm (by omega)
    have hpoint : Function.extend Fin.val x (fun _ => 0) m = 0 :=
      Function.extend_apply' x (fun _ => 0) m hnot
    simpa [hm] using hpoint

private lemma displacement_functionExtend_fin_val {n : ℕ} (x : Fin n → ℝ)
    (j : Fin (n + 1)) :
    AdditivePath.displacement j.val (Function.extend Fin.val x (fun _ => 0)) =
      Fin.partialSum x j := by
  have h := congrFun
    (AdditivePath.finitePrefix_restrict_eq_fromIncrements
      (0 : ℝ) (Function.extend Fin.val x (fun _ => 0))) j
  simpa [AdditivePath.finitePrefix, AdditivePath.fromIncrements,
    functionExtend_fin_val_eq_piecewise] using h.symm

/-- At each of its `n + 1` grid knots, the finite normalized step path is the
corresponding scaled finite partial sum. -/
lemma finiteNormalizedStepPath_apply_grid {n : ℕ} (hn : 0 < n)
    (scale : ℝ) (x : Fin n → ℝ) (j : Fin (n + 1)) :
    finiteNormalizedStepPath scale x (normalizedGridPoint hn j) =
      finiteNormalizedStepKnots scale x j := by
  rw [finiteNormalizedStepPath,
    RandomWalk.normalizedStepCadlagPathIcc_apply]
  change RandomWalk.normalizedStepPath (fun _ => scale) n
    (Function.extend Fin.val x (fun _ => 0)) ((j.val : ℝ) / n) = _
  rw [RandomWalk.normalizedStepPath_grid (fun _ => scale) hn
    (Function.extend Fin.val x (fun _ => 0))]
  rw [displacement_functionExtend_fin_val]

/-- The event that the finite normalized path lies in a `J₁` ball around a
specified linear reference path. -/
def finiteLinearPathBallEvent (scale slope radius : ℝ) {n : ℕ} :
    Set (Fin n → ℝ) :=
  {x | finiteNormalizedStepPath scale x ∈
    Metric.ball (Skorokhod.linearPath slope) radius}

end ProbabilityTheory.RandomWalk.SmallDeviation.Entrance

end
