module

public import Probability.Process.RandomWalk.Kernel.Basic
public import Mathlib.Analysis.Complex.Exponential
public import Mathlib.MeasureTheory.Measure.Prod
public import Mathlib.MeasureTheory.Measure.Typeclasses.Probability
public import Mathlib.Probability.Independence.Integration
public import Mathlib.Probability.Independence.InfinitePi

/-!
# Endpoint operators for independent-increment random walks

For an increment law $\nu$ on $\mathbb R$, `endpointOperator` is
$Q_\nu f(x)=\int f(x+y)\,d\nu(y)$. The exponential endpoint operator
inserts the factor $e^y$ in this integral. Their recursive iterates are
identified with integrals of the partial-sum position under the canonical IID
sequence law.

## Public declarations

- `endpointOperator` and `exponentialEndpointOperator`: the one-step
  convolution and exponentially weighted endpoint operators.
- `endpointOperator_eq_lintegral_incrementKernel`: the unweighted operator is
  the action of the generic random-walk transition kernel.
- `endpointIterate` and `exponentialEndpointIterate`: their recursive
  iterates; `measurable_endpointOperator`,
  `measurable_exponentialEndpointOperator`, `measurable_endpointIterate`, and
  `measurable_exponentialEndpointIterate` give measurability for S-finite
  increment laws.
- `iidPosition_indepFun_next`: the partial sum of the first $n$ increments is
  independent of the next increment under `iidSequenceLaw \nu`.
- `endpointIterate_operator` and `exponentialEndpointIterate_operator`:
  applying one more transition agrees with the $(n+1)$-st iterate.
- `lintegral_iidPosition_eq_endpointIterate` and
  `lintegral_iidPosition_expWeighted_eq_endpointIterate`: identify the
  unweighted and exponentially weighted endpoint iterates with their
  partial-sum integrals under `iidSequenceLaw \nu`.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal

@[expose] public section


namespace ProbabilityTheory.RandomWalk

/-- Apply one additive increment to a nonnegative endpoint test. -/
noncomputable def endpointOperator (ν : Measure ℝ)
    (f : ℝ → ENNReal) (x : ℝ) : ENNReal :=
  ∫⁻ y, f (x + y) ∂ν

/-- Apply one additive increment with the exponential weight `e^y`. -/
noncomputable def exponentialEndpointOperator (ν : Measure ℝ)
    (f : ℝ → ENNReal) (x : ℝ) : ENNReal :=
  ∫⁻ y, ENNReal.ofReal (Real.exp y) * f (x + y) ∂ν

/-- Iterate the endpoint operator generated by an increment law. -/
noncomputable def endpointIterate (ν : Measure ℝ) :
    ℕ → (ℝ → ENNReal) → ℝ → ENNReal
  | 0, f => f
  | n + 1, f => endpointOperator ν (endpointIterate ν n f)

/-- Iterate the endpoint operator with exponential increment weights. -/
noncomputable def exponentialEndpointIterate (ν : Measure ℝ) :
    ℕ → (ℝ → ENNReal) → ℝ → ENNReal
  | 0, f => f
  | n + 1, f => exponentialEndpointOperator ν
      (exponentialEndpointIterate ν n f)

theorem measurable_endpointOperator
    (ν : Measure ℝ) [SFinite ν] {f : ℝ → ENNReal} (hf : Measurable f) :
    Measurable (endpointOperator ν f) := by
  apply Measurable.lintegral_prod_right
  fun_prop

theorem measurable_exponentialEndpointOperator
    (ν : Measure ℝ) [SFinite ν] {f : ℝ → ENNReal} (hf : Measurable f) :
    Measurable (exponentialEndpointOperator ν f) := by
  apply Measurable.lintegral_prod_right
  fun_prop

theorem endpointOperator_eq_lintegral_incrementKernel
    (ν : Measure ℝ) [SFinite ν] {f : ℝ → ENNReal}
    (hf : Measurable f) (x : ℝ) :
    endpointOperator ν f x = ∫⁻ y, f y ∂incrementKernel ν x := by
  rw [endpointOperator, incrementKernel_apply, lintegral_map hf
    (measurable_const_add x)]

theorem measurable_endpointIterate
    (ν : Measure ℝ) [SFinite ν] {f : ℝ → ENNReal} (hf : Measurable f) :
    ∀ n, Measurable (endpointIterate ν n f)
  | 0 => hf
  | n + 1 => measurable_endpointOperator ν
      (measurable_endpointIterate ν hf n)

theorem measurable_exponentialEndpointIterate
    (ν : Measure ℝ) [SFinite ν] {f : ℝ → ENNReal} (hf : Measurable f) :
    ∀ n, Measurable (exponentialEndpointIterate ν n f)
  | 0 => hf
  | n + 1 => measurable_exponentialEndpointOperator ν
      (measurable_exponentialEndpointIterate ν hf n)

theorem iidPosition_indepFun_next (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (n : ℕ) :
    IndepFun (AdditivePath.displacement n) (fun increment : ℕ → ℝ => increment n)
      (iidSequenceLaw ν) := by
  have h := (iidSequenceLaw_independent ν).indepFun_finsetSum_of_notMem
    (s := Finset.range n) (i := n)
    (fun _ => measurable_pi_apply _) Finset.notMem_range_self
  convert h using 1
  ext increment
  simp [AdditivePath.displacement]

/-- Iterating a fixed transition after applying it once is the same as one
more left-recursive iteration. -/
theorem endpointIterate_operator
    (ν : Measure ℝ) (n : ℕ) (f : ℝ → ENNReal) :
    endpointIterate ν n (endpointOperator ν f) =
      endpointIterate ν (n + 1) f := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change endpointOperator ν
          (endpointIterate ν n (endpointOperator ν f)) =
        endpointOperator ν (endpointIterate ν (n + 1) f)
      exact congrArg (endpointOperator ν) ih

/-- A transition iterate is the endpoint expectation of its canonical
independent-increment random walk. -/
theorem lintegral_iidPosition_eq_endpointIterate
    (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {f : ℝ → ENNReal} (hf : Measurable f) :
    ∀ (n : ℕ) (x : ℝ),
      (∫⁻ increment, f (x + AdditivePath.displacement n increment)
          ∂(iidSequenceLaw ν)) =
        endpointIterate ν n f x
  | 0, x => by simp [AdditivePath.displacement, endpointIterate]
  | n + 1, x => by
      let P := iidSequenceLaw ν
      have hSn : Measurable (AdditivePath.displacement (E := ℝ) n) :=
        displacement_measurable n
      have hXn : Measurable (fun increment : ℕ → ℝ => increment n) :=
        measurable_pi_apply n
      have hind := iidPosition_indepFun_next ν n
      have hpair : P.map (fun increment =>
          (AdditivePath.displacement n increment, increment n)) =
          (P.map (AdditivePath.displacement n)).prod
            (P.map (fun increment : ℕ → ℝ => increment n)) :=
        hind.map_prod_eq_prod_map_map hSn.aemeasurable hXn.aemeasurable
      change (∫⁻ increment, f (x + AdditivePath.displacement (n + 1) increment) ∂P) =
        endpointIterate ν (n + 1) f x
      simp only [AdditivePath.displacement, Finset.sum_range_succ]
      calc
        (∫⁻ increment, f (x +
            (AdditivePath.displacement n increment + increment n)) ∂P) =
            ∫⁻ z : ℝ × ℝ, f (x + (z.1 + z.2))
              ∂P.map (fun increment =>
                (AdditivePath.displacement n increment, increment n)) := by
              rw [lintegral_map (by fun_prop) (hSn.prodMk hXn)]
        _ = ∫⁻ z : ℝ × ℝ, f (x + (z.1 + z.2))
              ∂(P.map (AdditivePath.displacement n)).prod ν := by
              rw [hpair, iidSequenceLaw_map_apply ν n]
        _ = ∫⁻ s, ∫⁻ y, f (x + (s + y)) ∂ν
              ∂P.map (AdditivePath.displacement n) := by
              exact lintegral_prod _ (by fun_prop)
        _ = ∫⁻ increment, endpointOperator ν f
              (x + AdditivePath.displacement n increment) ∂P := by
              rw [lintegral_map (by fun_prop) hSn]
              apply lintegral_congr
              intro increment
              simp only [endpointOperator]
              apply lintegral_congr
              intro y
              exact congrArg f
                (add_assoc x (AdditivePath.displacement n increment) y).symm
        _ = endpointIterate ν n (endpointOperator ν f) x := by
              exact lintegral_iidPosition_eq_endpointIterate ν
                (measurable_endpointOperator ν hf) n x
        _ = endpointIterate ν (n + 1) f x :=
              congrFun (endpointIterate_operator ν n f) x


theorem exponentialEndpointIterate_operator
    (ν : Measure ℝ) (n : ℕ) (f : ℝ → ENNReal) :
    exponentialEndpointIterate ν n (exponentialEndpointOperator ν f) =
      exponentialEndpointIterate ν (n + 1) f := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change exponentialEndpointOperator ν
          (exponentialEndpointIterate ν n (exponentialEndpointOperator ν f)) =
        exponentialEndpointOperator ν (exponentialEndpointIterate ν (n + 1) f)
      exact congrArg (exponentialEndpointOperator ν) ih

/-- The reciprocal-weight iterate is the endpoint expectation of the
canonical independent-increment random walk. -/
theorem lintegral_iidPosition_expWeighted_eq_endpointIterate
    (ν : Measure ℝ) [IsProbabilityMeasure ν]
    {f : ℝ → ENNReal} (hf : Measurable f) :
    ∀ (n : ℕ) (x : ℝ),
      (∫⁻ increment,
          ENNReal.ofReal (Real.exp (AdditivePath.displacement n increment)) *
            f (x + AdditivePath.displacement n increment)
          ∂(iidSequenceLaw ν)) =
        exponentialEndpointIterate ν n f x
  | 0, x => by simp [AdditivePath.displacement, exponentialEndpointIterate]
  | n + 1, x => by
      let P := iidSequenceLaw ν
      have hSn : Measurable (AdditivePath.displacement (E := ℝ) n) :=
        displacement_measurable n
      have hXn : Measurable (fun increment : ℕ → ℝ => increment n) :=
        measurable_pi_apply n
      have hind := iidPosition_indepFun_next ν n
      have hpair : P.map (fun increment =>
          (AdditivePath.displacement n increment, increment n)) =
          (P.map (AdditivePath.displacement n)).prod
            (P.map (fun increment : ℕ → ℝ => increment n)) :=
        hind.map_prod_eq_prod_map_map hSn.aemeasurable hXn.aemeasurable
      change (∫⁻ increment,
          ENNReal.ofReal (Real.exp (AdditivePath.displacement (n + 1) increment)) *
            f (x + AdditivePath.displacement (n + 1) increment) ∂P) =
        exponentialEndpointIterate ν (n + 1) f x
      simp only [AdditivePath.displacement, Finset.sum_range_succ]
      calc
        (∫⁻ increment,
            ENNReal.ofReal
                (Real.exp (AdditivePath.displacement n increment + increment n)) *
              f (x + (AdditivePath.displacement n increment + increment n)) ∂P) =
            ∫⁻ z : ℝ × ℝ,
              ENNReal.ofReal (Real.exp (z.1 + z.2)) *
                f (x + (z.1 + z.2))
              ∂P.map (fun increment =>
                (AdditivePath.displacement n increment, increment n)) := by
              rw [lintegral_map (by fun_prop) (hSn.prodMk hXn)]
        _ = ∫⁻ z : ℝ × ℝ,
              ENNReal.ofReal (Real.exp (z.1 + z.2)) *
                f (x + (z.1 + z.2))
              ∂(P.map (AdditivePath.displacement n)).prod ν := by
              rw [hpair, iidSequenceLaw_map_apply ν n]
        _ = ∫⁻ s, ∫⁻ y,
              ENNReal.ofReal (Real.exp (s + y)) *
                f (x + (s + y)) ∂ν
              ∂P.map (AdditivePath.displacement n) := by
              exact lintegral_prod _ (by fun_prop)
        _ = ∫⁻ s, ENNReal.ofReal (Real.exp s) *
              exponentialEndpointOperator ν f (x + s)
              ∂P.map (AdditivePath.displacement n) := by
              apply lintegral_congr
              intro s
              simp only [exponentialEndpointOperator]
              rw [← lintegral_const_mul
                (ENNReal.ofReal (Real.exp s)) (by fun_prop)]
              apply lintegral_congr
              intro y
              rw [Real.exp_add,
                ENNReal.ofReal_mul (le_of_lt (Real.exp_pos s)), mul_assoc]
              congr 2
              exact congrArg f (add_assoc x s y).symm
        _ = ∫⁻ increment,
              ENNReal.ofReal (Real.exp (AdditivePath.displacement n increment)) *
                exponentialEndpointOperator ν f
                  (x + AdditivePath.displacement n increment) ∂P := by
              have hU : Measurable (exponentialEndpointOperator ν f) :=
                measurable_exponentialEndpointOperator ν hf
              have hexp : Measurable
                  (fun s : ℝ => ENNReal.ofReal (Real.exp s)) := by
                fun_prop
              have houter : Measurable (fun s : ℝ =>
                  ENNReal.ofReal (Real.exp s) *
                    exponentialEndpointOperator ν f (x + s)) :=
                hexp.mul (hU.comp (measurable_const.add measurable_id))
              rw [lintegral_map houter hSn]
        _ = exponentialEndpointIterate ν n
              (exponentialEndpointOperator ν f) x := by
              exact lintegral_iidPosition_expWeighted_eq_endpointIterate ν
                (measurable_exponentialEndpointOperator ν hf) n x
        _ = exponentialEndpointIterate ν (n + 1) f x :=
              congrFun (exponentialEndpointIterate_operator ν n f) x

end ProbabilityTheory.RandomWalk
