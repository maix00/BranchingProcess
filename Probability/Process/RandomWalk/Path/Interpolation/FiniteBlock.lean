module

public import Probability.Process.RandomWalk.Path.Interpolation
public import Probability.Sequence.Block

/-!
# Polygonal paths from finite increment blocks

The public definitions and theorems in this file are:

- `ProbabilityTheory.RandomWalk.extendFiniteIncrementBlock`:
  extend $b\in\mathbb R^n$ to a sequence by assigning zero after $n$.
- `ProbabilityTheory.RandomWalk.measurable_extendFiniteIncrementBlock`:
  this extension is measurable.
- `ProbabilityTheory.RandomWalk.normalizedLinearContinuousPathFromBlock`:
  the polygonal unit-time path generated by a finite block.
- `ProbabilityTheory.RandomWalk.measurable_normalizedLinearContinuousPathFromBlock`:
  this finite-block path map is measurable.
- `ProbabilityTheory.RandomWalk.normalizedLinearContinuousPathFromBlock_blockCoordinates`:
  forming a block from a sequence and then interpolating agrees with
  interpolating the corresponding shifted sequence directly.

This is the path-level passage from Bolthausen's finite-block
Lemma 3.1 to the polygonal paths in Theorem 3.2 of
Erwin Bolthausen, *On a functional central limit theorem for random
walks conditioned to stay positive*, Ann. Probab. 4(3) (1976),
480--485, DOI 10.1214/aop/1176996098.
-/

@[expose] public section

namespace ProbabilityTheory.RandomWalk

open MeasureTheory

/-- Extend a finite increment block by zeros beyond its length. -/
noncomputable def extendFiniteIncrementBlock (n : ℕ) (block : Fin n → ℝ) :
    ℕ → ℝ := fun i => if h : i < n then block ⟨i, h⟩ else 0

/-- Zero extension of a finite increment block is measurable. -/
theorem measurable_extendFiniteIncrementBlock (n : ℕ) :
    Measurable (extendFiniteIncrementBlock n) := by
  rw [measurable_pi_iff]
  intro i
  by_cases hi : i < n
  · simpa [extendFiniteIncrementBlock, hi] using
      (measurable_pi_apply (⟨i, hi⟩ : Fin n))
  · simp [extendFiniteIncrementBlock, hi]

/-- The normalized polygonal path generated by a finite increment block. -/
noncomputable def normalizedLinearContinuousPathFromBlock
    (scale : ℕ → ℝ) (n : ℕ) (block : Fin n → ℝ) :
    C(unitInterval, ℝ) :=
  normalizedLinearContinuousPathIcc scale n
    (extendFiniteIncrementBlock n block)

/-- Finite-block polygonal interpolation is measurable. -/
theorem measurable_normalizedLinearContinuousPathFromBlock
    (scale : ℕ → ℝ) (n : ℕ) :
    Measurable (normalizedLinearContinuousPathFromBlock scale n) :=
  (measurable_normalizedLinearContinuousPathIcc scale n).comp
    (measurable_extendFiniteIncrementBlock n)

/-- Interpolation of the first `n` coordinates factors through their
finite block. -/
theorem normalizedLinearContinuousPathFromBlock_blockCoordinates
    (scale : ℕ → ℝ) (n start : ℕ) (increment : ℕ → ℝ) :
    normalizedLinearContinuousPathFromBlock scale n
        (Combinatorics.Sequence.blockCoordinates start n increment) =
      normalizedLinearContinuousPathIcc scale n
        (fun k => increment (start + k)) := by
  ext t
  change normalizedLinearPath scale n
      (extendFiniteIncrementBlock n
        (Combinatorics.Sequence.blockCoordinates start n increment)) t =
    normalizedLinearPath scale n (fun k => increment (start + k)) t
  unfold normalizedLinearPath
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  have hi' : i < n := Finset.mem_range.mp hi
  simp [extendFiniteIncrementBlock, hi', Combinatorics.Sequence.blockCoordinates]

end ProbabilityTheory.RandomWalk

end
