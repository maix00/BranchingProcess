module

public import Mathlib.Probability.Independence.Integration

/-!
# Integrals over independent events

These factorization results specialize independence of functions to indicators
of measurable events.

## Public declarations

- `ProbabilityTheory.integral_abs_mul_indicator_eq`:
  $\int |f|\mathbf 1_E\,d\mu=(\int |f|\,d\mu)\,\mu(E)$ when $f$ is
  integrable, $E$ is measurable, and $|f|$ is independent of $\mathbf 1_E$.
- `ProbabilityTheory.integral_sum_abs_mul_indicator_eq`: the same identity
  termwise for a finite sum of observables, each independent of $\mathbf 1_E$.
- `ProbabilityTheory.integral_const_add_finset_abs_mul_indicator_le`: if
  $C,B\ge 0$, $\sum_{i\in s}\int |f_i|\,d\mu\le B$, each $|f_i|$ is
  independent of $\mathbf 1_E$, and $\mu(E)\le p$, then
  $\int (C+\sum_{i\in s}|f_i|)\mathbf 1_E\,d\mu\le(C+B)p$.
- `ProbabilityTheory.integral_abs_mul_indicator_eq_of_indep`: the first
  identity from independence of the event's sigma-algebra and the sigma-algebra
  generated by $f$.
-/

open MeasureTheory
open scoped BigOperators

@[expose] public section

namespace ProbabilityTheory

/-- An integrable observable independent of a measurable event gains the
probability of that event exactly. -/
theorem integral_abs_mul_indicator_eq
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (f : Ω → ℝ) (E : Set Ω)
    (hf : Integrable f μ) (hE : MeasurableSet E)
    (hind : IndepFun (fun ω => |f ω|) (E.indicator (fun _ => (1 : ℝ))) μ) :
    (∫ ω, |f ω| * E.indicator (fun _ => (1 : ℝ)) ω ∂μ) =
      (∫ ω, |f ω| ∂μ) * μ.real E := by
  have habs : AEStronglyMeasurable (fun ω => |f ω|) μ :=
    hf.abs.aestronglyMeasurable
  have hfactor := hind.integral_mul_eq_mul_integral habs
    (measurable_const.indicator hE).aestronglyMeasurable
  change μ[(fun ω => |f ω|) * E.indicator (fun _ => (1 : ℝ))] = _
  rw [hfactor, integral_indicator_const (1 : ℝ) hE]
  simp

/-- A finite sum of integrable observables gains the probability of an event
term by term when every observable is independent of that event. Mutual
independence of the observables is not required. -/
theorem integral_sum_abs_mul_indicator_eq
    {Ω ι : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (s : Finset ι) (f : ι → Ω → ℝ) (E : Set Ω)
    (hf : ∀ i ∈ s, Integrable (f i) μ) (hE : MeasurableSet E)
    (hind : ∀ i ∈ s,
      IndepFun (fun ω => |f i ω|) (E.indicator (fun _ => (1 : ℝ))) μ) :
    (∫ ω, (∑ i ∈ s, |f i ω|) * E.indicator (fun _ => (1 : ℝ)) ω ∂μ) =
      (∑ i ∈ s, ∫ ω, |f i ω| ∂μ) * μ.real E := by
  simp_rw [Finset.sum_mul]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro i hi
    exact integral_abs_mul_indicator_eq μ (f i) E (hf i hi) hE (hind i hi)
  · intro i hi
    have hint := (hf i hi).abs.indicator hE
    convert hint using 1
    ext ω
    by_cases hω : ω ∈ E <;> simp [hω]

/-- A deterministic nonnegative offset plus finitely many integrable absolute
observables has exceptional-event expectation at most its first-moment bound
times the event probability, provided each observable is independent of the
event. The observables need not be mutually independent. -/
theorem integral_const_add_finset_abs_mul_indicator_le
    {Ω ι : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (s : Finset ι) (f : ι → Ω → ℝ) (E : Set Ω)
    (hf : ∀ i ∈ s, Integrable (f i) μ) (hE : MeasurableSet E)
    (hind : ∀ i ∈ s,
      IndepFun (fun ω => |f i ω|) (E.indicator (fun _ => (1 : ℝ))) μ)
    (C B p : ℝ) (hC : 0 ≤ C) (hB : 0 ≤ B)
    (hmoment : (∑ i ∈ s, ∫ ω, |f i ω| ∂μ) ≤ B)
    (hprob : μ.real E ≤ p) :
    (∫ ω, (C + ∑ i ∈ s, |f i ω|) *
        E.indicator (fun _ => (1 : ℝ)) ω ∂μ) ≤ (C + B) * p := by
  let indicator : Ω → ℝ := E.indicator (fun _ => (1 : ℝ))
  have hsumInt : Integrable (fun ω => ∑ i ∈ s, |f i ω|) μ :=
    integrable_finsetSum s (fun i hi => (hf i hi).abs)
  have hsumFactor := integral_sum_abs_mul_indicator_eq μ s f E hf hE hind
  have hsumBound :
      (∫ ω, (∑ i ∈ s, |f i ω|) * indicator ω ∂μ) ≤ B * μ.real E := by
    simpa only [indicator] using
      (show (∫ ω, (∑ i ∈ s, |f i ω|) *
          E.indicator (fun _ => (1 : ℝ)) ω ∂μ) ≤ B * μ.real E from by
        rw [hsumFactor]
        exact mul_le_mul_of_nonneg_right hmoment measureReal_nonneg)
  have hconstFun :
      (fun ω => C * indicator ω) = E.indicator (fun _ => C) := by
    funext ω
    by_cases hω : ω ∈ E <;> simp [indicator, hω]
  have hconstInt :
      (∫ ω, C * indicator ω ∂μ) = C * μ.real E := by
    calc
      (∫ ω, C * indicator ω ∂μ) =
          ∫ ω, E.indicator (fun _ => C) ω ∂μ := by rw [hconstFun]
      _ = μ.real E • C := integral_indicator_const C hE
      _ = C * μ.real E := by rw [smul_eq_mul, mul_comm]
  have hsumFun :
      (fun ω => (∑ i ∈ s, |f i ω|) * indicator ω) =
        E.indicator (fun ω => ∑ i ∈ s, |f i ω|) := by
    funext ω
    by_cases hω : ω ∈ E <;> simp [indicator, hω]
  have hsumProductInt :
      Integrable (fun ω => (∑ i ∈ s, |f i ω|) * indicator ω) μ := by
    rw [hsumFun]
    exact hsumInt.indicator hE
  have hconstProductInt : Integrable (fun ω => C * indicator ω) μ := by
    rw [hconstFun]
    exact (integrable_const C).indicator hE
  have htotalEq :
      (∫ ω, (C + ∑ i ∈ s, |f i ω|) * indicator ω ∂μ) =
        C * μ.real E +
          ∫ ω, (∑ i ∈ s, |f i ω|) * indicator ω ∂μ := by
    calc
      (∫ ω, (C + ∑ i ∈ s, |f i ω|) * indicator ω ∂μ) =
          ∫ ω, (C * indicator ω +
            (∑ i ∈ s, |f i ω|) * indicator ω) ∂μ := by
              rw [show (fun ω => (C + ∑ i ∈ s, |f i ω|) * indicator ω) =
                fun ω => C * indicator ω +
                  (∑ i ∈ s, |f i ω|) * indicator ω from by
                    funext ω
                    exact add_mul C _ _]
      _ = (∫ ω, C * indicator ω ∂μ) +
          ∫ ω, (∑ i ∈ s, |f i ω|) * indicator ω ∂μ :=
            integral_add hconstProductInt hsumProductInt
      _ = C * μ.real E +
          ∫ ω, (∑ i ∈ s, |f i ω|) * indicator ω ∂μ := by rw [hconstInt]
  have hOffsetMoment : 0 ≤ C + B := add_nonneg hC hB
  calc
    (∫ ω, (C + ∑ i ∈ s, |f i ω|) * indicator ω ∂μ) =
        C * μ.real E +
          ∫ ω, (∑ i ∈ s, |f i ω|) * indicator ω ∂μ := htotalEq
    _ ≤ C * μ.real E + B * μ.real E := add_le_add (le_rfl) hsumBound
    _ = (C + B) * μ.real E := by ring
    _ ≤ (C + B) * p := mul_le_mul_of_nonneg_left hprob hOffsetMoment

/-- Sigma-algebra form of `integral_abs_mul_indicator_eq`. -/
theorem integral_abs_mul_indicator_eq_of_indep
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (μ : Measure Ω)
    (mPast : MeasurableSpace Ω) (f : Ω → ℝ) (E : Set Ω)
    (hf : Integrable f μ)
    (hE : MeasurableSet[mPast] E) (hEfull : MeasurableSet[mΩ] E)
    (hind : Indep mPast (MeasurableSpace.comap f inferInstance) μ) :
    (∫ ω, |f ω| * E.indicator (fun _ => (1 : ℝ)) ω ∂μ) =
      (∫ ω, |f ω| ∂μ) * μ.real E := by
  have hindicator :
      (E.indicator (fun _ => (1 : ℝ))) ⟂ᵢ[μ] f :=
    hind.indicator_indepFun (1 : ℝ) hE
  have habs :
      (fun ω => |f ω|) ⟂ᵢ[μ] E.indicator (fun _ => (1 : ℝ)) := by
    have hcomp := hindicator.symm.comp
      (by fun_prop : Measurable fun x : ℝ => |x|) measurable_id
    simpa [Function.comp_def] using hcomp
  exact @integral_abs_mul_indicator_eq Ω mΩ μ f E hf hEfull habs

end ProbabilityTheory

end
