namespace OptionalLineFiltrationExamples

variable {Ω Root α : Type*} [mΩ : MeasurableSpace Ω]
    {past : Set (RootIndexed.TreeNode Root α) → MeasurableSpace Ω}
    {lines : ℕ → Ω → Set (RootIndexed.TreeNode Root α)}
    (h : ∀ n, IsOptionalLine past (lines n))
    (hmono : ∀ n m, n ≤ m → ∀ ω, RootIndexed.Line.Precedes (lines n ω) (lines m ω))
    (μ : Measure Ω) [IsFiniteMeasure μ]

include hmono in
-- The native tower law applies to ordered optional lines without assuming a
-- branching model or that the lines intersect every infinite branch.
theorem tower (f : Ω → ℝ) {n m : ℕ} (hnm : n ≤ m) :
    μ[μ[f | (h m).measurableSpace] | (h n).measurableSpace] =ᵐ[μ]
      μ[f | (h n).measurableSpace] :=
  condExp_condExp_of_le ((h n).measurableSpace_mono (h m) (hmono n m hnm))
    (h m).measurableSpace_le

theorem conditionalExpectation_martingale (f : Ω → ℝ) :
    Martingale (fun n => μ[f | (h n).measurableSpace])
      (IsOptionalLine.filtration h hmono) μ :=
  martingale_condExp f (IsOptionalLine.filtration h hmono) μ

-- The limiting sigma algebra is the information generated by the stopped
-- line spaces, rather than an assertion that they generate all ambient information.
include hmono in
theorem upward_ae (f : Ω → ℝ) :
    ∀ᵐ ω ∂μ, Tendsto (fun n => (μ[f | (h n).measurableSpace]) ω) atTop
      (𝓝 ((μ[f | ⨆ n, (h n).measurableSpace]) ω)) :=
  tendsto_ae_condExp (ℱ := IsOptionalLine.filtration h hmono) f

include hmono in
theorem upward_L1 (f : Ω → ℝ) :
    Tendsto (fun n => eLpNorm
      (μ[f | (h n).measurableSpace] - μ[f | ⨆ n, (h n).measurableSpace]) 1 μ)
      atTop (𝓝 0) :=
  tendsto_eLpNorm_condExp (ℱ := IsOptionalLine.filtration h hmono) f

-- An empty line never intersects a branch. Its stopped information can be
-- trivial even when the ambient space contains nontrivial information.
def emptyLines (_n : ℕ) (_b : Bool) : Set (RootIndexed.TreeNode Unit Bool) := ∅

theorem empty_optional (n : ℕ) :
    IsOptionalLine (fun _ => (⊥ : MeasurableSpace Bool)) (emptyLines n) :=
  IsOptionalLine.const _ IsAntichain.empty

theorem empty_mono (n m : ℕ) (_ : n ≤ m) (b : Bool) :
    RootIndexed.Line.Precedes (emptyLines n b) (emptyLines m b) :=
  RootIndexed.Line.Precedes.refl _

theorem empty_filtration (n : ℕ) :
    IsOptionalLine.filtration empty_optional empty_mono n = ⊥ := by
  exact IsOptionalLine.measurableSpace_const (fun _ _ _ => le_refl _)
    IsAntichain.empty bot_le

example (ν : Measure Bool) [IsFiniteMeasure ν] (f : Bool → ℝ) :
    Tendsto (fun n => eLpNorm
      (ν[f | IsOptionalLine.filtration empty_optional empty_mono n] - ν[f | ⊥]) 1 ν)
      atTop (𝓝 0) := by
  have hlim : (⨆ n, (empty_optional n).measurableSpace) = ⊥ := by
    change (⨆ n, IsOptionalLine.filtration empty_optional empty_mono n) = ⊥
    simp only [empty_filtration, iSup_const]
  simpa only [IsOptionalLine.filtration_apply, hlim] using
    upward_L1 empty_optional empty_mono ν f

end OptionalLineFiltrationExamples

